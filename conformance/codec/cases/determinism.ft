// LANG-06-06: Map and Set iteration order is deterministic per build. 300 keys arrive in a seeded pseudo-random
// order, a third of them are written twice, and the program prints a digest of both iteration orders and the
// canonical text of each. codec_check.py runs it 100 times under different interpreter hash seeds.
import fortis.host { Host, Console, Random }
export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  summarise(caps.random.seeded(29), caps.console)
}
func summarise(random: Random, out: Console) Void {
  let mut words: Map[String, Int] = Map.default()
  let mut seen: Set[String] = Set.default()
  let mut numbers: Set[Int] = Set.default()
  for i in 0..<300 {
    let k = random.below(1000)
    editable words.set("w${k}", i)
    discard editable seen.add("w${k}")
    discard editable numbers.add(500 - k)
  }
  let mut order = ""
  for k in seen {
    order = "${order}${k},"
  }
  out.print("${words.count()} ${seen.count()} ${numbers.count()}")
  out.print(order)
  out.print(words.toText())
  out.print(numbers.toText())
}
