// D-400: a binding that holds a loan is charged the lent type's `cleanup` effects, although a loan's end destroys
// nothing (7.9): a `??` whose fallback fails (`let t = xs.get(0) ?? fail Missing()`) and a binding of a whole-loan
// type (`let t = alias b.t` in a function whose result is `from b`) each make both checkers attribute the `io` of
// `Token`'s `cleanup` to the function, which then needs an Authority value it does not use: E-EFF-010 on `label`
// and on `through`, from both checkers, for a program that prints nothing from either. The same `??` with an
// element whose `cleanup` has no effect is accepted, as is `let t = xs.get(0)` followed by `t?.label ?? "none"`.
// v0.0.1 behaved the same. Found by the v0.0.2-rc.9 wide review (Kimi K3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

class Box {
  t: Token
}

export error Missing {
  code: "demo.missing"
}

try func label(xs: List[Token]) String {
  let t = xs.get(0) ?? fail Missing()
  return copy t.label
}

func through(b: Box) alias Token from b {
  let t = alias b.t
  return t
}

func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(Token(label: String.from("x"), console: console.retain()))
  let a = label(xs) catch e {
    report e
    recover "none"
  }
  console.print("a ${a}")
  let b = Box(t: Token(label: String.from("bt"), console: console.retain()))
  console.print("b ${through(alias b).label}")
}
