// accept neighbours of the closure rule that box through `dynamic fn`.
// Not a gate program: a dynamic fn is a boxed closure, and the native parity
// audit counts boxed closures. Both checkers must accept every function here.
func pick(b: Bool) (dynamic fn(Int) Int)? {
  let f: (dynamic fn(Int) Int)? = if b { give fn(x: Int) Int => x } else { give fn(x: Int) Int => Int.saturatingAdd(x, 1) }
  return move f
}

func boxedList() List[dynamic fn(Int) Int]? {
  let xs: List[dynamic fn(Int) Int]? = List.of(fn(x: Int) Int => x, fn(x: Int) Int => Int.saturatingAdd(x, 1))
  return move xs
}

func boxedRecord() { fs: List[dynamic fn(Int) Int] } {
  let r: { fs: List[dynamic fn(Int) Int] } = { fs: List.of(fn(x: Int) Int => x, fn(x: Int) Int => Int.saturatingAdd(x, 1)) }
  return move r
}

func boxedTuple() (List[dynamic fn(Int) Int], Int) {
  let pair: (List[dynamic fn(Int) Int], Int) = (List.of(fn(x: Int) Int => x, fn(x: Int) Int => Int.saturatingMul(x, 2)), 1)
  return move pair
}
