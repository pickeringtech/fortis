// D-415: an anonymous record returned by `return r` past a deferred block that reads it does not build natively,
// whatever its field types: `let r = { n: 5, m: 8 }`, `defer { console.print("bye ${r.n}") }`, `return r` is
// rustc E0382 (borrow of moved value `r`) in the generated Rust, reported as E-INT-002, because the lowering derives
// `Clone` but not `Copy` for a record type, so the return moves the record where a trivial class (`#[derive(Copy)]`),
// a tuple or an enum of trivial parts is copied (6.11, 7.5). Both checkers accept the program (a record of trivial
// fields is trivial, so `return r` is a read), and the interpreter and the VM print `bye 5|got 5|bye 7|got 7|end`
// with the trace `loans-end|defer|loans-end|defer`; a record holding a trivial class (`points`) and one of integers
// (`ints`) fail the same way. v0.0.1 behaved the same (adapted for its `main`). Found by the fixture of D-411
// (exec_defer_trivial_class.ft) in the v0.0.2-rc.10 re-check's fixes; the record forms run on the interpreter and
// the VM under compiler/crates/fortisc/tests/owned_part/record_past_defer.ft.
import fortis.host { Console }

trivial class Point {
  export x: Int
  export y: Int
}

func ints(console: Shared[Console]) { n: Int, m: Int } {
  let r = { n: 5, m: 8 }
  defer {
    console.print("bye ${r.n}")
  }
  return r
}

func points(console: Shared[Console]) { p: Point, n: Int } {
  let r = { p: Point(x: 7, y: 6), n: 8 }
  defer {
    console.print("bye ${r.p.x}")
  }
  return r
}

func main(console: Console) {
  let shared = Shared.create(move console)
  let a = ints(shared)
  shared.print("got ${a.n}")
  let b = points(shared)
  shared.print("got ${b.p.x}")
  shared.print("end")
}
