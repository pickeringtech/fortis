// D-382, the cursor shape: `let mut c = alias fresh(console).iterate()`, 7.6's own spelling of a cursor, on a
// temporary receiver. Both checkers accept it; the interpreter reads `fresh` as a place and stops with a dynamic
// failure (`fresh` is not declared, exit 2); the VM and native code refuse the program with the wrong message
// (`unbuilt:line 26: no method iterate on ListCursor[Token]`, exit 1): the method exists on `List`, and it is the
// marker-on-call lowering that misreads the receiver. Without the marker the loan of the temporary is D-392.
// Pre-existing since v0.0.1, identical on every tool. Found by the v0.0.2-rc.9 wide review (GLM 5.3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func fresh(console: Shared[Console]) List[Token] {
  return List.of(make(console, "t1"), make(console, "t2"))
}

func cursorOfTemporary(console: Shared[Console]) {
  let mut c = alias fresh(console).iterate()
  console.print("cur ${c.next()?.label ?? "?"}")
}

func main(console: Console) {
  let shared = Shared.create(move console)
  cursorOfTemporary(shared)
  shared.print("end")
}
