// D-251: on this master both checkers reject the unprefixed `Green`, whose name is also a class's, with E-TYP-040
// (type Green is used as a value), so the program does not reach the VM; `List.of(Red)` expected as `List[Light]`
// is accepted and prints 1 on the interpreter, the VM and native (LR 9.7). The backend refusals the record names
// ("type `Green` used as a value", "type `Red` has no declaration") do not reproduce; its note says so.
import fortis.host { Host }

enum Light derive Equatable {
  Red
  Green
}

class Green {
  export n: Int
}

pure func green() Light => Green

pure func code(l: Light) Int {
  return match l {
    Red => 1
    Green => 2
  }
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print("${code(green())}")
  let xs: List[Light] = List.of(Red)
  for x in xs {
    caps.console.print("${code(x)}")
  }
}
