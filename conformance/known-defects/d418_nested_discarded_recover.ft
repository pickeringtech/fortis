// D-418: native lowering refuses a nested recovery whose try calls lend a Token and whose
// innermost fallback makes one. Both checkers accept. After D-454's statement-temporary fix,
// the interpreter and VM print `drop made|end` with the trace `drop Token`; native refuses
// the generated Rust with E0308 because the nested fallback joins a loan and an owned value.
// Expected on every backend: `drop made|end`, trace `drop Token`.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

export error Missing {
  code: "demo.missing"
}

try func find(xs: List[Token]) alias Token from xs {
  match xs.get(0) {
    present(t) => { return t }
    null => { fail Missing() }
  }
}

recovers func main(out: Console) {
  let console = Shared.create(move out)
  let xs: List[Token] = List.default()
  discard find(alias xs) or recover (find(alias xs) or recover make(console, "made"))
  console.print("end")
}
