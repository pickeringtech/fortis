// D-392: a loan taken from a call's temporary receiver (`let t = fresh(console).get(0)`, `.first()`, a `??` whose
// left side is one, and a cursor of a temporary list) passes both checkers: E-OWN-051 covers a temporary argument
// (own_from_temporary.ft), not a receiver. The temporary is destroyed at the statement's end (7.9), so the binding
// reads an element whose `cleanup` has run: the interpreter and the VM print
// `drop t1|drop t2|got t1|drop f1|drop f2|first f1|drop c1|drop c2|co c1|drop u1|drop u2|cur u1|end`; native code
// refuses the program (rustc E0277 here, E0499 for `get` alone). v0.0.1 behaved the same and destroyed the element
// once more at the binding's end. Found by the v0.0.2-rc.9 wide review (GLM 5.3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func fresh(console: Shared[Console], a: StringView, b: StringView) List[Token] {
  return List.of(make(console, a), make(console, b))
}

func lentGet(console: Shared[Console]) {
  let t = fresh(console, "t1", "t2").get(0)
  console.print("got ${t?.label ?? "?"}")
}

func lentFirst(console: Shared[Console]) {
  let t = fresh(console, "f1", "f2").first()
  console.print("first ${t?.label ?? "?"}")
}

func lentCoalesce(console: Shared[Console]) {
  let t = fresh(console, "c1", "c2").get(0) ?? make(console, "fb")
  console.print("co ${t.label}")
}

func lentCursor(console: Shared[Console]) {
  let mut c = fresh(console, "u1", "u2").iterate()
  let item = c.next()
  console.print("cur ${item?.label ?? "?"}")
}

func main(console: Console) {
  let shared = Shared.create(move console)
  lentGet(shared)
  lentFirst(shared)
  lentCoalesce(shared)
  lentCursor(shared)
  shared.print("end")
}
