// accept
// covers: LANG-08-04
// Not a gate program: a closure stored in a class field does not build natively (D-157 item 1).
// Spreading the one lambda a class holds into a class that holds none yet stores that lambda.
class A {
  export run: fn(Int) Int
}

class B {
  export run: fn(Int) Int
}

func run() Int {
  let a = A(run: pure noalloc fn(x: Int) Int => x)
  let into = B(...move a)
  discard into
  return 0
}
