// D-389: inside an arm of a `match` returned as a `from` result, an `if` whose branches give a loan and a value of
// the function's own may be bound and given on (`let v = if flag { give x } else { give move d }` then `give v`,
// in `present(x) =>` of `return match empty.get(0) { … }` from `(alias Token from empty)?`): both checkers accept
// it, since the `if` joins to the loan type and the rule of D-381 does not enter an `if` or `match` nested in an
// arm's statements. The interpreter and the VM destroy the moved value at the call and later reads see it destroyed
// (`drop fallback|first dead|second dead|end|drop x0`; the cleanup here marks the label so the reads show); native
// code refuses the program (rustc E0308, the shape of D-361). Pre-existing since v0.0.1, whose interpreter and VM
// also ran the cleanup twice (`drop fallback|first dead|second dead|drop dead|end|drop x0`). Found by the
// v0.0.2-rc.9 re-check (GLM 5.3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
    self.label = String.from("dead")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func pick(empty: List[Token], d: owned Token, flag: Bool, console: Shared[Console]) (alias Token from empty)? {
  return match empty.get(0) {
    present(x) => {
      let v = if flag { give x } else { give move d }
      give v
    }
    null => {
      give null
    }
  }
}

func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "x0"))
  {
    let r = pick(alias xs, make(console, "fallback"), false, console)
    console.print("first ${r?.label ?? "none"}")
    console.print("second ${r?.label ?? "none"}")
  }
  console.print("end")
}
