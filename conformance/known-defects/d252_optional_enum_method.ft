// D-252: on this master both checkers reject `lights.get(0)?.code()` with E-TYP-040 (`code` is a method, called as
// `.code()`, never taken as a value), so the VM stop the record names ("no payload field `code`") and the native
// build failure (E0615) are not reached; its note says so. The loop's `l.code()` is accepted.
import fortis.host { Host }

enum Light derive Equatable {
  Red
  Amber

  export pure func code(self) Int {
    return match self {
      Red => 1
      Amber => 2
    }
  }
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let mut lights: List[Light] = List.default()
  editable lights.push(Light.Red)
  for l in lights {
    caps.console.print("${l.code()}")
  }
  caps.console.print("${lights.get(0)?.code() ?? 0}")
}
