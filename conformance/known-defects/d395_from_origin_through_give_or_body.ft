// D-395: a result declared `from xs` that lends `ys` instead is E-OWN-050 when returned directly or through a
// `match` expression (a check new in v0.0.2), but not when given out of an `if` (`give ys.get(0)`) or produced by
// an expression body (`=> ys.get(0)`): both checkers accept both functions here, so the loan is recorded against
// the wrong owner and `ys` may change while the result lives. The interpreter and the VM pop and destroy `y` and
// then read it (`drop y|got y|drop y|got y|drop x`); native code refuses the program (rustc E0621). v0.0.1
// accepted every form, the direct return included, and read the destroyed element the same way. Found by the
// v0.0.2-rc.9 wide review (Kimi K3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func given(xs: List[Token], ys: List[Token], c: Bool) (alias Token from xs)? {
  return if c {
    give xs.get(0)
  } else {
    give ys.get(0)
  }
}

func body(xs: List[Token], ys: List[Token]) (alias Token from xs)? => ys.get(0)

func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "x"))
  let mut ys: List[Token] = List.default()
  ys.push(make(console, "y"))
  {
    let t = given(alias xs, alias ys, false)
    discard ys.pop()
    console.print("got ${t?.label ?? "none"}")
  }
  ys.push(make(console, "y"))
  {
    let t = body(alias xs, alias ys)
    discard ys.pop()
    console.print("got ${t?.label ?? "none"}")
  }
}
