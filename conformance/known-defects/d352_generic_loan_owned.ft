// D-352: a generic body is Unknown to both checkers, so a loan made owned (D-341) is not caught there.
// `func id[T](x: T) T { return x }` returns its read parameter and `func first[T](xs: List[T]) T? { return xs.get(0) }`
// returns the list's element, each as an owned value. Both checkers accept; the interpreter and the VM print
// `item 9 y 9|list 9 z 9` (each result aliases what it was lent); native code does not build (rustc E0308). The
// same functions without the type parameter are E-OWN-001. Generics are in v0.1's scope.
import fortis.host { Console }

class Item {
  n: Int
}

func id[T](x: T) T {
  return x
}

func first[T](xs: List[T]) T? {
  return xs.get(0)
}

func main(console: Console) {
  let item = Item(n: 1)
  let mut y = id(item)
  y.n = 9
  console.print("item ${item.n} y ${y.n}")
  let mut xs: List[Item] = List.default()
  xs.push(Item(n: 1))
  let mut z = first(xs) ?? Item(n: 0)
  z.n = 9
  let n = match xs.get(0) {
    present(w) => w.n
    null => 0
  }
  console.print("list ${n} z ${z.n}")
}
