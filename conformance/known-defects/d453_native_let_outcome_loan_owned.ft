// D-453: a `let` binding of an `or recover` or a `catch ... recover` whose try side succeeds with a loan and
// whose replacement is a moved local (`let t = find(alias xs) or recover move d1`,
// `let u = find(alias xs) catch e { recover move d2 }`, `find` a `try` function whose result is
// `alias Token from xs`) passes both checkers, which type the binding as the try side's loan, and runs on the
// interpreter and the VM (`show a|show a|after|drop held2|drop held1|drop a`), the binding destroying only a
// value it owns; native code does not build it: rustc E0308, `match` arms have incompatible types, at the
// lowering of a binding the checkers type as a loan and whose recover paths give an owned value. A loud
// refusal of a program two backends run; a sibling of D-361, where an `if` gives a loan on one branch and a
// value of its own on the other. Found by the v0.1 stream A fix of D-451, in `let` probes.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func show(console: Shared[Console], t: Token) {
  console.print("show ${t.label}")
}

export error Missing {
  code: "demo.missing"
}

try func find(xs: List[Token]) alias Token from xs {
  match xs.get(0) {
    present(t) => { return t }
    null => { fail Missing() }
  }
}

recovers func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "a"))
  let d1 = make(console, "held1")
  let d2 = make(console, "held2")
  {
    let t = find(alias xs) or recover move d1
    show(console, move t)
  }
  {
    let u = find(alias xs) catch e { recover move d2 }
    show(console, move u)
  }
  console.print("after")
}
