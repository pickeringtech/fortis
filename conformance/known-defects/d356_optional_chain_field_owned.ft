// D-356: a field read through an optional loan with `?.` is typed as an owned value, so it escapes the loan (D-341):
// `xs.get(0)?.inner` is `Inner?`, not a loan, and `let mut g = f ?? Inner(n: 0)` edits the list's own element. Both
// checkers accept; the interpreter and the VM print `g 9 list 9`, native code `g 9 list 1` (it copies the field).
import fortis.host { Console }

class Inner {
  n: Int
}

class Item {
  inner: Inner
}

func main(console: Console) {
  let mut xs: List[Item] = List.default()
  xs.push(Item(inner: Inner(n: 1)))
  let f = xs.get(0)?.inner
  let mut g = f ?? Inner(n: 0)
  g.n = 9
  let n = match xs.get(0) {
    present(w) => w.inner.n
    null => 0
  }
  console.print("g ${g.n} list ${n}")
}
