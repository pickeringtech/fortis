// D-375: a `??` whose fallback is a value of the statement's own (`empty.get(0) ?? move d`, `?? make(…)`), lent to
// a read parameter, is a temporary of the statement (7.9): native code destroys it when the statement ends and
// prints `show arg|drop arg|after arg`. The interpreter and the VM never destroy it: they print `show arg|after arg`
// and the fallback's cleanup is lost. Both checkers accept the program. Pre-existing since v0.0.1, whose interpreter
// printed the same. Bind the value first (`let t = empty.get(0) ?? move d`, then `show(console, t)`): the binding
// owns it and every backend runs the cleanup when the block ends.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func show(console: Shared[Console], t: Token) {
  console.print("show ${t.label}")
}

func main(out: Console) {
  let console = Shared.create(move out)
  let empty: List[Token] = List.default()
  {
    let d = make(console, "arg")
    show(console, empty.get(0) ?? move d)
    console.print("after arg")
  }
  console.print("end")
}
