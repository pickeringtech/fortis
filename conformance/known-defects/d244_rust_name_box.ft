// D-244: a type named like an item the generated Rust uses does not build natively. Here a class `Box` beside a
// recursive enum, which native code boxes with Rust's `Box` (rustc E0107). The interpreter and the VM print `3 2`.
// `Vec`, `From` and `String` fail in any program, and `Option` beside an optional.
import fortis.host { Console }

class Box {
  v: Int
}

enum Chain {
  End(value: Int)
  Next(tail: Chain)
}

func depth(c: Chain) Int {
  return match c {
    End(value: _) => 1
    Next(tail: t) => Int.saturatingAdd(depth(t), 1)
  }
}

func main(console: Console) {
  let b = Box(v: 3)
  let c = Chain.Next(tail: End(value: 1))
  console.print("${b.v} ${depth(c)}")
}
