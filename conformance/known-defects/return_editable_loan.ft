// D-185 (docs/delivery/defects.json): natively `return editable c` from a function whose result is `editable Counter
// from c` lowers to `&*c`, a read reference, so the program does not build (E0308); the interpreter and the VM print
// `access|9`.
import fortis.host { Host, Console }

export class Counter {
  export n: Int<0..100>
}

func access(c: editable Counter, console: Console) editable Counter from c {
  console.print("access")
  return editable c
}

func setNine(c: editable Counter) Void {
  c.n = 9
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let mut counter = Counter(n: 1)
  setNine(access(editable counter, caps.console))
  caps.console.print("${counter.n}")
}
