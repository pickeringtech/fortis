// D-394: a lent `match` payload is destroyed at the arm's end rather than its owner's. `plainOptional` matches
// `move o` where `o = xs.get(0)`: the interpreter and the VM run the element's `cleanup` when the arm ends and a
// read after the match sees it destroyed (`v x|drop x|after match x`); native code destroys it with `xs`
// (`v x|after match x|end|drop x`). `outcome` matches the `Outcome` of a `try` function whose result is that loan:
// the interpreter destroys at the arm's end (`v x|drop x|after match x|end`), the VM and native code at the
// owner's (`v x|after match x|end|drop x`). `ownerChanges` pushes to `xs` while the `Outcome` still holds the
// loan, which both checkers accept (a kept `Outcome` does not freeze the owner as a kept optional does): the
// interpreter prints `v x|drop x|end|drop y`, the VM `v x|end|drop x|drop y`, and native code refuses the program
// (rustc E0502), so the whole file does not build natively; the first two functions alone build and print as
// stated. v0.0.1 ran the cleanup twice on the interpreter and the VM in every shape (`…|drop x|…|drop x`) and
// its native code did not build the `Outcome` shapes (rustc E0261). Found by the v0.0.2-rc.9 wide review (Kimi K3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

export error Missing {
  code: "demo.missing"
}

try func pick(xs: List[Token], c: Bool) (alias Token from xs)? {
  if c {
    return xs.get(0)
  }
  fail Missing()
}

func plainOptional(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "x"))
  {
    let o = xs.get(0)
    match move o {
      present(v) => {
        console.print("v ${v.label}")
      }
      null => console.print("none")
    }
    console.print("after match ${xs.get(0)?.label ?? "none"}")
  }
  console.print("end")
}

recovers func outcome(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "x"))
  {
    let o = pick(alias xs, true)
    match move o {
      success(v) => {
        console.print("v ${v?.label ?? "none"}")
      }
      failure(f) => {
        report f
        console.print("f")
      }
    }
    console.print("after match ${xs.get(0)?.label ?? "none"}")
  }
  console.print("end")
}

recovers func ownerChanges(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "x"))
  let o = pick(alias xs, true)
  xs.push(make(console, "y"))
  match move o {
    success(v) => {
      console.print("v ${v?.label ?? "none"}")
    }
    failure(f) => {
      report f
      console.print("f")
    }
  }
  console.print("end")
}

func main(out: Console) {
  let console = Shared.create(move out)
  plainOptional(console)
  outcome(console)
  ownerChanges(console)
}
