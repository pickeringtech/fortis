// D-388: a function whose result is declared `from` a parameter may bind a tuple built around a value of its own
// and return the binding inside `present` (`let t = (empty.get(0) ?? move d, 1)` then `return present(t)` from
// `(alias (Token, Int) from empty)?`): both checkers accept it, since the rule of D-381 judges the returned
// expression, and a binding read lends when the tuple holds any loan part. The interpreter runs the fallback's
// cleanup at the call and the caller then reads the destroyed value (`drop fallback|value dead|end`; the cleanup
// here marks the label so the read shows), the VM never runs the cleanup (`value fallback|end`) and native code
// refuses the program (rustc E0308). Pre-existing since v0.0.1, whose interpreter ran the cleanup twice (`drop
// fallback|value dead|drop dead|end`), whose VM lost it the same way and whose native code refused the program
// (rustc E0261). Found by the v0.0.2-rc.9 re-check (GLM 5.3).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
    self.label = String.from("dead")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func wrapped(empty: List[Token], d: owned Token) (alias (Token, Int) from empty)? {
  let t = (empty.get(0) ?? move d, 1)
  return present(t)
}

func main(out: Console) {
  let console = Shared.create(move out)
  let empty: List[Token] = List.default()
  {
    let r = wrapped(alias empty, make(console, "fallback"))
    match r {
      present(p) => { console.print("value ${p.0.label}") }
      null => { console.print("none") }
    }
  }
  console.print("end")
}
