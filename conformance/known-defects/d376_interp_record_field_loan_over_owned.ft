// D-376: assigning a loan to a field of a record literal that held a value of the record's own (`rec.item =
// xs.get(0) ?? make(…)` after `{ item: empty.get(0) ?? move d, … }`) must destroy the old value and leave the field
// a loan (7.9; D-366). The VM prints `drop old|replaced list side|drop side|list list|drop list`. The interpreter
// never runs `old`'s cleanup and destroys the list's element with the record (`replaced list side|drop list|drop
// side|list list`), then reads the destroyed element. Native code does not build a record holding a loan (D-360).
// Both checkers accept the program. Pre-existing since v0.0.1, whose interpreter printed the same and ran the
// element's cleanup twice.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func main(out: Console) {
  let console = Shared.create(move out)
  let empty: List[Token] = List.default()
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "list"))
  let d = make(console, "old")
  {
    let mut rec = { item: empty.get(0) ?? move d, side: make(console, "side") }
    rec.item = xs.get(0) ?? make(console, "z")
    console.print("replaced ${rec.item.label} ${rec.side.label}")
  }
  console.print("list ${xs.get(0)?.label ?? "none"}")
  console.print("end")
}
