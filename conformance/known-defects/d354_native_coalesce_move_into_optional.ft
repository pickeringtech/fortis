// D-354: an owned optional local of a class with `cleanup`, written without a marker on the left of a `??` that
// moves its fallback, does not build natively (rustc E0382, use of moved value `none`). The interpreter and the VM
// print `d` and run `d`'s cleanup once. `move none ?? move d` builds. That the unmarked place is accepted at all is
// D-357.
import fortis.host { Console }

class Token {
  label: String

  cleanup(editable self) {
    log.info("drop ${self.label}")
  }
}

func main(console: Console) {
  let none: Token? = null
  let d = Token(label: String.from("d"))
  let p: Token? = none ?? move d
  console.print("${p?.label ?? "none"}")
}
