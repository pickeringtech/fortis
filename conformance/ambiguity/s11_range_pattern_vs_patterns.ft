// accept — S11: a range pattern against the forms it overlaps: a binding, a literal, a variant, a
// one-element tuple pattern, a constant call as a bound, a nested payload pattern, and an or-pattern
enum Flag {
  High(value: Int)
  Low
}

class Point {
  x: Int
  y: Int
}

func classify(n: Int, t: (Int, Int), f: Flag) Int {
  match n {
    5 => {
      return 1
    }
    x => {
      discard x
      return 2
    }
  }
  match t {
    (1) => {
      return 3
    }
    (1..3, 7) => {
      return 4
    }
    (_, _) => {
      return 5
    }
  }
  match f {
    High(1..9) => {
      return 6
    }
    High(1) => {
      return 7
    }
    High(value) => {
      discard value
      return 8
    }
    Low => {
      return 9
    }
  }
  match n {
    Point(1)..2 => {
      return 10
    }
    1..3 | 7..9 => {
      return 11
    }
    otherwise => {
      return 0
    }
  }
}
