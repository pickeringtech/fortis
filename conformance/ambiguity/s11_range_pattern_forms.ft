// accept — S11: range pattern forms: inclusive, exclusive, one-sided low, one-sided high (both markers)
func classify(status: Int) Int {
  match status {
    200..299 => {
      return 1
    }
    300..<400 => {
      return 2
    }
    ..<200 => {
      return 3
    }
    ..299 => {
      return 4
    }
    500.. => {
      return 5
    }
    500..< => {
      return 6
    }
    otherwise => {
      return 0
    }
  }
}
