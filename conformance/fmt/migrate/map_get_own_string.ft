// A lookup's key copy goes only on the prelude's `Map[String, V]`, with `String.from` the prelude's: the checker
// resolves both, not their spelling. Here `String` is the module's own class and `get` a method of its own, so
// `lookup.get(String.from(key))` stays as written; dropping `String.from` would print 7, not 8 (6.7; X-345, R11;
// D-329). fmt_check runs `main` before and after the migration, and both print 8.
import fortis.host { Console }

class String {
  export func from(n: Int) Int => Int.wrappingAdd(n, 1)
}

class Lookup {
  export func get(self, n: Int) Int => n
}

func main(console: Console) {
  let lookup = Lookup()
  let key = 7
  let n = lookup.get(String.from(key))
  console.print("${n}")
}
