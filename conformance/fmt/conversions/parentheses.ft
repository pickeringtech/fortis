// execute: operand|7|true|abc|3|3|7|true
// covers: LANG-06-14, LANG-06-15
// D-505: the grammar decides grouping; operands run once and postfixes stay on the converted result.
import fortis.host { Console }

type Small = Int<0..100>

class Source { n: Int }
class Target derive From[Source], Equatable, Comparable { n: Int }

func operand(console: Console) Source {
  console.print("operand")
  return Source(n: 7)
}

try func checked(left: Int<0..5>, right: Int<0..5>) Int<0..100> {
  return Int<0..100>.validate(left - right) or fail
}

try func nested(raw: Int) Small {
  return Small.validate(Int<0..10>.validate(raw) or fail) or fail
}

try func main(console: Console) {
  let source = operand(console)
  let target = Target.from(source)
  console.print("${target.n}")
  console.print("${Target.from(source) < Target(n: 9)}")
  let bytes = String.from("abc").toBytes()
  let text = String.fromBytes(bytes) or fail
  console.print(text)
  let difference = checked(5, 2) or fail
  console.print("${difference}")
  let narrowed = nested(3) or fail
  console.print("${narrowed}")
  console.print("${Target.from(source).n}")
  console.print("${Target.from(source) >= Target(n: 7)}")
}
