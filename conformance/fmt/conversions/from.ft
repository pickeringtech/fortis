// execute: source|7|7|7|7|7|7
// covers: LANG-06-15
// Retired From and to spellings keep one evaluation, the target and postfix grouping.
import fortis.host { Console }

class Source {
  export n: Int
}

class Target derive From[Source] {
  export n: Int
}

class Holder {
  target: Target
}

func returned(s: Source) Target {
  return s.to()
}

func argument(t: Target) Int => t.n

func source(console: Console) Source {
  console.print("source")
  return Source(n: 7)
}

func main(console: Console) {
  let s = source(console)
  let t: Target = s.to()
  console.print("${t.n}")
  console.print("${argument(s.to())}")
  let holder = Holder(target: s.to())
  console.print("${holder.target.n}")
  console.print("${returned(s).n}")
  let direct = Target.from(s)
  console.print("${direct.n}")
  let grouped = (Target.from(s)).n
  console.print("${grouped}")
}
