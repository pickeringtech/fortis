// execute: 5|9223372036854775807|0|2|7|[1, 2, 3, 5, 8, 9]|[]|[4]
// requires: runtime
// covers: LANG-06-04
// fortis.numeric and fortis.collections bodies: abs saturates at Int.min; sorted is a stable merge sort.
import fortis.host { Console }
import fortis.numeric { abs, min, max }
import fortis.collections { sorted }
func main(console: Console) {
  console.print("${abs(-5)}")
  console.print("${abs(-9223372036854775807 - 1)}")
  console.print("${abs(0)}")
  console.print("${min(2, 7)}")
  console.print("${max(2, 7)}")
  console.print("${sorted(List.of(5, 3, 9, 1, 8, 2))}")
  let none: List[Int] = List.default()
  console.print("${sorted(none)}")
  console.print("${sorted(List.of(4))}")
}
