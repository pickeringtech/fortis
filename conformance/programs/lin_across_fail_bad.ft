// reject: E-OBL-005 (at the marked lines)
// covers: LANG-06-09
export class Tx {
  witness: Must
  export func begin() Tx => Tx(witness: Must.create())
  export func commit(owned self) {
    let Tx(witness: w) = move self
    Must.discharge(move w)
  }
}
try func step(n: Int) Int => n
async try func fetch(n: Int) Int => n
async try func run(n: Int) Int {
  let tx = Tx.begin()
  let a = step(n) or fail                  // reject: E-OBL-005 — tx is live across an unwind point and is not Abandonable
  let b = await fetch(n) or fail           // reject: E-OBL-005 — a cancellation point
  move tx.commit()
  return Int.saturatingAdd(a, b)
}
