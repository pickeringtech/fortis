// execute: done
// reports: task-lifecycle:state=not_started
// requires: runtime
// covers: LANG-12-03
// 12.3: a never-polled future may be discarded; it emits a not_started lifecycle record.
import fortis.host { Host, Console }
async func work(n: Int) Int => n
export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  discard work(1)
  caps.console.print("done")
}
