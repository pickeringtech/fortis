// execute: done
// reports: task-completion:outcome=Defect
// requires: runtime
// covers: LANG-10-06, LANG-12-04
// 10.8: unbounded recursion in a detached task exhausts its stack. The VM and the interpreter terminate the task
// and keep the process, and its supervisor records TaskCompletion.Defect; native code aborts the process (DEL-40).
import fortis.host { Supervisor, Console }
func deep(n: Int) Int => deep(Int.wrappingAdd(n, 1))
async func broken() Int {
  return deep(0)
}
async func run(supervisor: Supervisor) {
  scope tasks {
    let t = tasks.launch(broken())
    tasks.detach(move t, supervisor)
  }
}
async func main(supervisor: Supervisor, console: Console) {
  await run(supervisor)
  console.print("done")
}
