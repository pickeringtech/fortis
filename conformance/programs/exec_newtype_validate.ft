// execute: adult|rejected refinement.out_of_range|minor
// requires: runtime
// covers: LANG-06-03
import fortis.host { Console }
export type Age = Int<0..150>
func classify(age: Age) String {
  if age < Age(18) {
    return "minor"
  }
  return "adult"
}
recovers func main(console: Console) {
  let a = Age.validate(42) or recover Age(0)
  console.print(classify(a))
  match Age.validate(200) {
    success(ok) => console.print("accepted")
    failure(f) => {
      console.print("rejected ${f.code}")
      report f
    }
  }
  console.print(classify(Age(3)))
}
