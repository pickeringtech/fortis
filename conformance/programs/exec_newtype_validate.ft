// execute: adult|rejected refinement.out_of_range|minor
// requires: runtime
// covers: LANG-06-03
import fortis.host { Host }
export type Age = Int<0..150>
func classify(age: Age) String {
  if age < Age(18) {
    return "minor"
  }
  return "adult"
}
export recovers func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let a = Age.validate(42) or recover Age(0)
  caps.console.print(classify(a))
  match Age.validate(200) {
    success(ok) => caps.console.print("accepted")
    failure(f) => {
      caps.console.print("rejected ${f.code}")
      report f
    }
  }
  caps.console.print(classify(Age(3)))
}
