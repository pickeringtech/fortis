// execute: made 1|cleanup 1|after
// requires: runtime
// covers: LANG-07-07
// 7.9: `Mutex.create` of a class value is a temporary when nothing binds the mutex. Destroying the mutex
// destroys the value it owns, so that value's cleanup runs at the end of the statement.
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id, console: console.retain())
  }
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

func run(console: Shared[Console]) {
  discard Mutex.create(Handle.make(1, alias console))
  console.print("after")
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
}
// execute-trace:
