// execute: true|true|true|false
// requires: runtime
// covers: LANG-06-05
import fortis.host { Console }

func main(console: Console) {
  let n = Float.sqrt(-1.0)
  console.print("${Float.totalOrder(-0.0) < Float.totalOrder(0.0)}")
  console.print("${Float.totalOrder(n) > Float.totalOrder(1.0 / 0.0)}")
  console.print("${Float.totalOrder(-1.0) < Float.totalOrder(-0.5)}")
  console.print("${-0.0 < 0.0}")
}
