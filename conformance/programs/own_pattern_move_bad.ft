// reject: E-OWN-001 (at the marked line)
// covers: LANG-09-06
export enum Slot {
  Empty
  Full(label: String)
}
func keep(s: owned String) {
}
func run(slot: Slot) {
  match slot {
    Full(label: l) => keep(move l)         // reject: E-OWN-001 — a payload binding of `match slot` is a read loan
    Empty => {}
  }
}
