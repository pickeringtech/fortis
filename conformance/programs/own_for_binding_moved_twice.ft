// reject: E-OWN-020 (at the marked line)
// covers: LANG-07-04
// The `for` binding is fresh on every iteration, but moving it twice within one iteration is still a use after move.
func take(s: owned String) Int => s.byteCount()
func main() {
  let items = List.of(String.from("a"), String.from("bc"))
  let mut total = 0
  for s in move items {
    total = Int.saturatingAdd(total, take(move s))
    total = Int.saturatingAdd(total, take(move s))      // reject: E-OWN-020
  }
}
