// execute: present|nonempty|absent|absent
// requires: runtime
// covers: LANG-11-07
// Environment.get returns Secret[String]?; revealing needs SecretAccess (15).
import fortis.host { Environment, SecretAccess, reveal, Console }
func describe(env: Environment, access: SecretAccess, name: StringView) StringView from static {
  return match env.get(name) {
    present(s) => if reveal(s, access).scalarCount() > 0 {
      give "nonempty"
    } else {
      give "empty"
    }
    null => "absent"
  }
}
func main(environment: Environment, console: Console, secretAccess: SecretAccess) {
  let home = environment.get("PATH")
  let found = match home {
    present(s) => "present"
    null => "absent"
  }
  console.print(found)
  console.print(describe(environment, secretAccess, "PATH"))
  console.print(describe(environment, secretAccess, "FORTIS_SURELY_UNSET_VARIABLE"))
  console.print(describe(environment, secretAccess, ""))
}
