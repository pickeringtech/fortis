// reject: E-EFF-010 (at the marked line)
// covers: LANG-11-07
// A function that reaches the FileSystem capability through the Capabilities record has no Authority in its signature (11.6).
import fortis.host { Host, Capabilities, Path }
try func peek(caps: Capabilities) String {
  let p = Path.parse("note.txt") or fail
  return caps.fileSystem.readText(p) or fail     // reject: E-EFF-010 — io without a FileSystem parameter
}
export func main(args: List[String]) Void {
}
