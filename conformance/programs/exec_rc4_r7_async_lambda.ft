// execute: before|body|3
// requires: runtime
// covers: LANG-08-04
import fortis.host { Console }
func work(console: Console) Int {
  console.print("body")
  return 3
}
async func main(console: Console) {
  let f: async fn(Console) Int = async fn(c: Console) Int => work(c)
  let pending = f(console)
  console.print("before")
  let n = await pending
  console.print("${n}")
}
