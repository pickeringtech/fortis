// execute: defect:stack_exhaustion
// requires: runtime
// covers: LANG-10-06
import fortis.host { Console }

func deep(n: Int) Int => deep(Int.wrappingAdd(n, 1))

try recovers func main(console: Console) {
  let v = deep(0) + 1 catch e {
    console.print("caught")
    recover 0
  }
  console.print("${v}")
}
