// execute: numeric.overflow|numeric.overflow
// requires: runtime
// covers: LANG-06-04
import fortis.host { Console }

try recovers func main(console: Console) {
  let big = Duration.hours(2562047)
  let sum = Duration.add(big, big) catch e {
    console.print(e.code)
    recover 0s
  }
  discard sum
  let product = Duration.multiply(big, 3) catch e {
    console.print(e.code)
    recover 0s
  }
  discard product
}
