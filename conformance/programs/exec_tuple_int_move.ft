// execute: consume 1|drop 2|consume 4|drop 3
// requires: runtime
// covers: LANG-07-07
// 7.9: moving an `Int` out of a temporary tuple reads that element. The sibling that owns cleanup stays until
// the end of the statement, after the call, and leaves no `drop` trace (D-333).
import fortis.host { Host, Console, Capabilities }

class N {
  id: Int
  console: Shared[Console]
  cleanup(editable self) Void { self.console.print("drop ${self.id}") }
}

func consume(n: Int, console: Shared[Console]) Void {
  console.print("consume ${n}")
}

func first(console: Shared[Console]) Void {
  consume((1, N(id: 2, console: console.retain())).0, alias console)
}

func second(console: Shared[Console]) Void {
  consume((N(id: 3, console: console.retain()), 4).1, alias console)
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let Capabilities(console: out, fileSystem: fs, network: net, clock: clock, random: rnd, environment: env, process: proc, supervisor: sup, secretAccess: sec, rawSql: sql) = move caps
  let console = Shared.create(move out)
  first(console)
  second(console)
}
