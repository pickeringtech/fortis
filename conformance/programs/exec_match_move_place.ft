// execute: made 1|using 1|drop|end|cleanup 1
// execute-trace: drop N|loans-end|drop Handle
// requires: runtime
// covers: LANG-07-07
// 9.8, 7.9: `match move` of a whole local consumes that local. The arm's binding is the owner, and the
// local must not run cleanup again on the way out. A binding that the arm returns keeps the value; a
// binding the arm consumes drops it once, before the statement after the match.
import fortis.host { Host, Console, Capabilities }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id: id, console: console.retain())
  }
  cleanup(editable self) Void {
    self.console.print("cleanup ${self.id}")
  }
}

class N {
  console: Shared[Console]
  cleanup(editable self) Void {
    self.console.print("drop")
  }
}

func consume(n: owned N) Void {}

func take(console: Shared[Console]) Handle {
  let e = Handle.make(1, alias console)
  return match move e {
    h => move h
  }
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let Capabilities(console: out, fileSystem: fs, network: net, clock: clock, random: rnd, environment: env, process: proc, supervisor: sup, secretAccess: sec, rawSql: sql) = move caps
  let console = Shared.create(move out)
  let h = take(console)
  console.print("using ${h.id}")
  let x = N(console: console.retain())
  match move x {
    n => { consume(move n) }
  }
  console.print("end")
}
