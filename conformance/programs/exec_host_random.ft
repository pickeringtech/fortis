// execute: 3|3|true
// requires: runtime
// covers: LANG-11-07
// The development Random is SplitMix64: a seeded generator replays its sequence exactly.
import fortis.host { Random, Console }
func draw(r: Random) Int => r.below(10)
func main(random: Random, console: Console) {
  let a = random.seeded(42)
  let b = random.seeded(42)
  let x = draw(a)
  let y = draw(b)
  console.print("${x}")
  console.print("${y}")
  console.print("${x == y}")
}
