// execute: done
// reports: task-completion:outcome=Defect
// requires: runtime
// covers: LANG-10-06, LANG-12-04
// 10.8: a runtime_invariant defect in a detached task. The VM and the interpreter terminate the task and keep the process,
// and its supervisor records TaskCompletion.Defect; native code aborts the process (DEL-40).
import fortis.host { Supervisor, Console }
async func broken() Int {
  injectDefect("runtime_invariant")
}
async func run(supervisor: Supervisor) {
  scope tasks {
    let t = tasks.launch(broken())
    tasks.detach(move t, supervisor)
  }
}
async func main(supervisor: Supervisor, console: Console) {
  await run(supervisor)
  console.print("done")
}
