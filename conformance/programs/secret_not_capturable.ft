// reject: E-TYP-090 (at the marked line)
// covers: LANG-13-01
// A Secret is never captured: an observation field of type Secret is rejected (13, 15).
import fortis.host { Secret }
observation Login {                              // reject: E-TYP-090 — Secret[String] is not Encodable
  password: Secret[String]           required: all
}
