// execute: 2.5000000000000000000000000000|3.3333333333333333333333333333
// requires: runtime
// covers: LANG-06-04
// Money.divide follows Decimal division (6.4): the largest scale that fits, rounded half to even.
import fortis.host { Host }
import fortis.money { Money, Currency, CurrencyMismatch }
export try func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let quarter = Money.divide(Money.of(Currency.GBP, 10.00d), 4) or fail
  let third = Money.divide(Money.of(Currency.GBP, 10d), 3) or fail
  caps.console.print("${quarter.amount}")
  caps.console.print("${third.amount}")
}
