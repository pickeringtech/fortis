// execute: 2.5000000000000000000000000000|3.3333333333333333333333333333
// requires: runtime
// covers: LANG-06-04
// Money.divide follows Decimal division (6.4): the largest scale that fits, rounded half to even.
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
try func main(console: Console) {
  let quarter = Money.divide(Money.of(GBP, 10.00d), 4) or fail
  let third = Money.divide(Money.of(GBP, 10d), 3) or fail
  console.print("${quarter.amount}")
  console.print("${third.amount}")
}
