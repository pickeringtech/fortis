// execute: 2 3|north 9
// requires: runtime
// covers: LANG-06-01
import fortis.host { Console }

pure func pair() (Int, Int) => (2, 3)

func main(console: Console) {
  let p = pair()
  let (a, b) = move p                      // destructuring consumes a place (LR 5.1)
  console.print("${a} ${b}")
  let point = { heading: "north", distance: 9 }
  console.print("${point.heading} ${point.distance}")
}
