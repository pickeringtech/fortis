// execute: 1970-01-01T00:00:00Z|1970-01-01T00:01:30Z|true|false|false|true|true
// requires: runtime
// covers: LANG-06-04
// 15: Timestamp.epoch, Timestamp.add and the ordering functions; a Timestamp displays as RFC 3339 in UTC.
import fortis.host { Console }
try func main(console: Console) {
  let start = Timestamp.epoch()
  let later = Timestamp.add(start, Duration.seconds(90)) or fail
  console.print("${start}")
  console.print("${later}")
  console.print("${Timestamp.after(later, start)}")
  console.print("${Timestamp.before(later, start)}")
  console.print("${Timestamp.after(start, start)}")
  console.print("${later > start}")
  console.print("${start == Timestamp.epoch()}")
}
