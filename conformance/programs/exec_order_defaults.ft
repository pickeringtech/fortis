// execute: 1|1|1
// requires: runtime
// covers: LANG-05-07
// 5.8: a default is re-evaluated at each call that omits the argument: every call gets a fresh list.
import fortis.host { Console }
func fill(items: owned List[Int] = List.default()) Int {
  let mut mine = move items
  mine.push(1)
  return mine.count()
}
func main(console: Console) {
  console.print("${fill()}")
  console.print("${fill()}")
  console.print("${fill()}")
}
