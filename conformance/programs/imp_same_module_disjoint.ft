// accept
// covers: LANG-04-03
// The same module may be imported twice when the imports bind disjoint names (4.3): what 4.3 rejects is one name
// bound twice, not one module named twice.
import fortis.host { Console }
import fortis.money { Money }
import fortis.money { Currency }

func main(console: Console) {
  console.print("${Money.zero(GBP)}")
}
