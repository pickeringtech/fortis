// execute: 2 noted, 1 remembered
// requires: runtime
// covers: LANG-05-08, LANG-11-09
// `@ignorable` on a declaration lets a call statement drop its non-linear result without `discard` (5.5, 11.8;
// X-345, R17), on a function and on a method; `discard` stays accepted.
import fortis.host { Console }

class Notes {
  export seen: Set[Int]
  @ignorable
  export func note(editable self, n: Int) Bool {
    return self.seen.add(n)
  }
  func count(self) Int {
    return self.seen.count()
  }
}

@ignorable
func remember(seen: editable Set[Int], n: Int) Bool {
  return seen.add(n)
}

func main(console: Console) {
  let mut notes = Notes(seen: Set.default())
  notes.note(1)
  notes.note(1)
  notes.note(2)
  discard notes.note(2)
  let mut seen: Set[Int] = Set.default()
  remember(editable seen, 7)
  remember(editable seen, 7)
  console.print("${notes.count()} noted, ${seen.count()} remembered")
}
