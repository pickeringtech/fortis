// execute: 7 8
// requires: runtime
// covers: LANG-08-01
import fortis.host { Console }
try func value[T](n: T) Int => 7
class Box[T] { export try func value(n: T) Int => 8 }
try func main(console: Console) {
  let f: try fn(Int) Int = value
  let g = Box[Int].value
  let a = f(1) or fail
  let b = g(1) or fail
  console.print("${a} ${b}")
}
