// execute: 2 3
// requires: runtime
// covers: LANG-08-04
import fortis.host { Console }
class Box { export n: Int }
type Count = Int
func main(console: Console) {
  let make = fn(n: Int) Box => Box(n)
  let wrap = fn(n: Int) Count => Count(n)
  let b = make(2)
  console.print("${b.n} ${wrap(3) as Int}")
}
