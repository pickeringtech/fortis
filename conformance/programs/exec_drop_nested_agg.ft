// execute: list|drop 1|drop 2|map|drop 3|enum|drop 4|tuple|drop 5|drop 6|bare|drop 7|field|drop 8
// requires: runtime
// covers: LANG-07-07
// 7.9: destroying a class, enum or tuple destroys an aggregate nested in it (a list field, a map field, an enum
// payload, a nested tuple), once, when that owner dies. A field's cleanup is not a `drop N` trace event (D-306).
// The bare list and the direct class field are the same rule with nothing nested between the owner and the value.
import fortis.host { Console }

class N {
  id: Int
  console: Shared[Console]
  cleanup(editable self) { self.console.print("drop ${self.id}") }
}

class Box { items: List[N] }

class Carrier { items: Map[Int, N] }

class Outer { item: N }

enum Bag { Items(xs: List[N]) }

func classList(console: Shared[Console]) {
  let b = Box(items: List.of(N(id: 1, console: console.retain()), N(id: 2, console: console.retain())))
  console.print("list")
}

func classMap(console: Shared[Console]) {
  let mut items: Map[Int, N] = Map.default()
  items.set(1, N(id: 3, console: console.retain()))
  let b = Carrier(items: move items)
  console.print("map")
}

func enumList(console: Shared[Console]) {
  let b = Bag.Items(xs: List.of(N(id: 4, console: console.retain())))
  console.print("enum")
}

func nested(console: Shared[Console]) {
  let t = ((N(id: 5, console: console.retain()), N(id: 6, console: console.retain())), 0)
  console.print("tuple")
}

func bareList(console: Shared[Console]) {
  let xs = List.of(N(id: 7, console: console.retain()))
  console.print("bare")
}

func direct(console: Shared[Console]) {
  let o = Outer(item: N(id: 8, console: console.retain()))
  console.print("field")
}

func main(out: Console) {
  let console = Shared.create(move out)
  classList(console)
  classMap(console)
  enumList(console)
  nested(console)
  bareList(console)
  direct(console)
}
