// execute: 5|true
// requires: runtime
// covers: LANG-11-07
// reveal requires the SecretAccess capability; a Secret displays as a fingerprint, never its value.
import fortis.host { Host, SecretAccess, Environment, reveal }
func length(env: Environment, access: SecretAccess) Int {
  return match env.get("FORTIS_DEV_DEMO_SECRET") {
    present(s) => reveal(s, access).scalarCount()
    null => 5
  }
}
func main() {
  let caps = Host.capabilities()
  caps.console.print("${length(caps.environment, caps.secretAccess)}")
  let shown = match caps.environment.get("PATH") {
    present(s) => "${s}"
    null => "Secret(none)"
  }
  caps.console.print("${shown.scalarCount() == 16}")
}
