// execute: skip|made 2|cleanup 2|yes|made 3|cleanup 3|or|after
// execute-trace: drop Handle|drop Handle
// requires: runtime
// covers: LANG-07-07
// 5.7, 7.9: a condition's `&&` and `||` evaluate the right operand only when the left needs it. A temporary
// that operand would create is not created when the operand is skipped, and one that is created dies when
// the condition finishes, before the branch.
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id, console: console.retain())
  }
  export func open(self) Bool {
    return self.id != 0
  }
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

func run(console: Shared[Console]) {
  if false && Handle.make(1, alias console).open() {
    console.print("no")
  }
  console.print("skip")
  if true && Handle.make(2, alias console).open() {
    console.print("yes")
  }
  if false || Handle.make(3, alias console).open() {
    console.print("or")
  }
  console.print("after")
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
}
