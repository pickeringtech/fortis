// reject: E-OWN-053
// covers: LANG-07-06
// D-580: a generic function value cannot hide storage in its body.
pure func store[T](value: owned T) Int {
  let xs = List.of(move value)
  return xs.count()
}
pure func use(text: StringView) Int {
  let f: pure fn(owned StringView) Int = move store
  return f(text)
}
