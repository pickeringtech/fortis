// accept
// covers: LANG-06-08
// A null test narrows an editable optional receiver before the call (LR 6.8). The `editable` loan
// drops later facts about that place; it does not drop the type of the call the loan belongs to.
export class Cell {
  export n: Int
  export pure func read(self) Bool => self.n == 0
  export func change(editable self) Void {
    self.n = 1
  }
}

export class Holder {
  export p: Cell?
}

export func viaIf(p: editable Cell?) Bool {
  if p != null {
    editable p.change()
    return true
  }
  return false
}

export func viaGuard(p: editable Cell?) Bool {
  if p == null {
    return false
  }
  editable p.change()
  return true
}

export func viaField(d: editable Holder) Bool {
  if d.p != null {
    editable d.p.change()
    return true
  }
  return false
}
