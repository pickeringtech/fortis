// reject: E-OWN-053
// covers: LANG-07-06
// D-580, X-605: an owned container cannot retain a non-static loan.
pure func consume[T](value: owned T) Int {
  let xs = List.of(move value)
  return xs.count()
}
pure func relay[U](value: owned U) Int => consume(move value)
pure func size(v: StringView) Int => relay(v)
