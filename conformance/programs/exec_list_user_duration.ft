// execute: 1
// requires: runtime
// covers: LANG-04-03
// `List[Duration].default` is the core list of this program's `Duration`, not `rt::Duration` (D-142).
import fortis.host { Console }

class Duration {
  export n: Int
}

func main(console: Console) {
  let f: fn() List[Duration] = List[Duration].default
  let mut xs = f()
  xs.push(Duration(n: 7))
  console.print("${xs.count()}")
}
