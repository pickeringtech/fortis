// execute: 2|3 4|2|true|false
// requires: runtime
// covers: LANG-07-06, LANG-06-14, LANG-06-16
import fortis.host { Console }
try func main(console: Console) {
  let parts = "3, 4".split(",")
  let b = parts.tryMap(fn(t) => t.trim() as Int) or fail
  console.print("${b.count()}")
  let mapped = parts.map(fn(t) => t.trim() as Int or recover 0)
  console.print("${mapped.get(0) ?? 0} ${mapped.get(1) ?? 0}")
  let filtered = parts.filter(fn(t) => (t.trim() as Int or recover 0) > 0)
  console.print("${filtered.count()}")
  console.print("${parts.any(fn(t) => (t.trim() as Int or recover 0) == 4)}")
  console.print("${parts.any(fn(t) => (t.trim() as Int or recover 0) == 9)}")
}
