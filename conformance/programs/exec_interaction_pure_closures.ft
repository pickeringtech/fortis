// execute: 12|6|3|scaled 30
// requires: runtime
// covers: LANG-11-01, LANG-08-01, LANG-08-02
// Programme 16, interaction `pure` + closure kinds: a `pure` function takes a `pure fn` callback, builds a pure
// `fn` over a trivial capture and consumes a `fn once` that moves a fresh value; all of it stays pure.
import fortis.host { Console }

pure func applyTwice(f: pure fn(Int) Int, x: Int) Int => f(f(x))

pure func scaledBy(factor: Int<0..100>, xs: List[Int<0..100>]) Int {
  let scale = pure fn[factor](x: Int<0..100>) Int => x * factor
  let mut total = 0
  for x in xs {
    total = Int.wrappingAdd(total, scale(x))
  }
  return total
}

pure func finish(items: owned List[Int]) Int {
  let consume = fn once[move items]() Int => items.count()
  return move consume()
}

func main(console: Console) {
  console.print("${applyTwice(pure fn(x: Int) Int => Int.wrappingMul(x, 2), 3)}")
  console.print("${applyTwice(pure fn(x: Int) Int => Int.wrappingAdd(x, 3), 0)}")
  console.print("${finish(List.of(1, 2, 3))}")
  console.print("scaled ${scaledBy(10, List.of(1, 2))}")
}
