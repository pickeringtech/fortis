// execute: before|defect:out_of_memory
// requires: runtime
// covers: LANG-10-06
// 10.8: a defect is never a Failure: the catch block does not run and no recovery value is produced.
import fortis.host { Host }
export error Bad {
  code: "demo.bad"
}
try func risky(n: Int) Int {
  if n < 0 {
    fail Bad()
  }
  injectDefect("out_of_memory")
}
export recovers func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print("before")
  let v = risky(1) catch e {
    caps.console.print("caught ${e.code}")
    recover 0
  }
  caps.console.print("after ${v}")
}
