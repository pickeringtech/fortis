// execute: 0|1.10|1.10
// requires: runtime
// covers: LANG-06-04
// Money.zero has scale 0; adding keeps the larger scale.
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
try func main(console: Console) {
  let nothing = Money.zero(GBP)
  console.print("${nothing.amount}")
  let some = Money.add(nothing, Money.of(GBP, 1.10d)) or fail
  console.print("${some.amount}")
  let again = Money.add(Money.of(GBP, 1.10d), nothing) or fail
  console.print("${again.amount}")
}
