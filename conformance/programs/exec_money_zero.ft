// execute: 0|1.10|1.10
// requires: runtime
// covers: LANG-06-04
// Money.zero has scale 0; adding keeps the larger scale.
import fortis.host { Host }
import fortis.money { Money, Currency, CurrencyMismatch }
export try func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let nothing = Money.zero(Currency.GBP)
  caps.console.print("${nothing.amount}")
  let some = Money.add(nothing, Money.of(Currency.GBP, 1.10d)) or fail
  caps.console.print("${some.amount}")
  let again = Money.add(Money.of(Currency.GBP, 1.10d), nothing) or fail
  caps.console.print("${again.amount}")
}
