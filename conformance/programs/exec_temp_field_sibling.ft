// execute: made 1|made 2|consume 1|cleanup 1|cleanup 2|after|made 1|made 2|consume 1|cleanup 1|cleanup 2|after
// execute-trace: drop Handle|drop Handle
// requires: runtime
// covers: LANG-07-09
// Moving one field out of a statement temporary leaves the others until the end of the statement, after the
// call (7.9). The class and the anonymous record agree. The moved field is not destroyed again.
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id, console: console.retain())
  }
  export func consume(owned self) {
    self.console.print("consume ${self.id}")
  }
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

export class Box {
  export h: Handle
  export k: Handle
}

func run(console: Shared[Console]) {
  Box(h: Handle.make(1, alias console), k: Handle.make(2, alias console)).h.consume()
  console.print("after")
  { h: Handle.make(1, alias console), k: Handle.make(2, alias console) }.h.consume()
  console.print("after")
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
}
