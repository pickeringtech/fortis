// requires: runtime
// covers: LANG-06-14
// D-655 and D-680: the shared numeric_text.json table, through every backend.
import fortis.host { Console }

recovers func readInt(text: StringView) String {
  let value = text as Int catch e { return e.code as String }
  return value as String
}

recovers func readInt64(text: StringView) String {
  let value = text as Int64 catch e { return e.code as String }
  return value as String
}

recovers func readInt32(text: StringView) String {
  let value = text as Int32 catch e { return e.code as String }
  return value as String
}

recovers func readInt16(text: StringView) String {
  let value = text as Int16 catch e { return e.code as String }
  return value as String
}

recovers func readInt8(text: StringView) String {
  let value = text as Int8 catch e { return e.code as String }
  return value as String
}

recovers func readUInt(text: StringView) String {
  let value = text as UInt catch e { return e.code as String }
  return value as String
}

recovers func readUInt64(text: StringView) String {
  let value = text as UInt64 catch e { return e.code as String }
  return value as String
}

recovers func readUInt32(text: StringView) String {
  let value = text as UInt32 catch e { return e.code as String }
  return value as String
}

recovers func readUInt16(text: StringView) String {
  let value = text as UInt16 catch e { return e.code as String }
  return value as String
}

recovers func readUInt8(text: StringView) String {
  let value = text as UInt8 catch e { return e.code as String }
  return value as String
}

recovers func readByte(text: StringView) String {
  let value = text as Byte catch e { return e.code as String }
  return value as String
}

recovers func readDecimal(text: StringView) String {
  let value = text as Decimal catch e { return e.code as String }
  return value as String
}

