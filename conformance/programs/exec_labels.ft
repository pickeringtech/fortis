// execute: 1-1|1-2|2-1|done
// requires: runtime
// covers: LANG-05-04
import fortis.host { Host }

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  outer: for i in 1..3 {
    for j in 1..3 {
      if j == 3 {
        continue outer
      }
      if i == 2 && j == 2 {
        break outer
      }
      caps.console.print("${i}-${j}")
    }
  }
  caps.console.print("done")
}
