// execute: 1-1|1-2|2-1|done
// requires: runtime
// covers: LANG-05-04
import fortis.host { Console }

func main(console: Console) {
  outer: for i in 1..3 {
    for j in 1..3 {
      if j == 3 {
        continue outer
      }
      if i == 2 && j == 2 {
        break outer
      }
      console.print("${i}-${j}")
    }
  }
  console.print("done")
}
