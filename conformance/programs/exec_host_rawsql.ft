// execute: sql.unavailable
// requires: runtime
// covers: LANG-11-07
// The development RawSql adapter has no database: every statement fails.
import fortis.host { RawSql, Console }
try func count(sql: RawSql) Int => sql.execute("select 1") or fail
recovers func main(rawSql: RawSql, console: Console) {
  let n = count(rawSql) catch e {
    console.print(e.code)
    recover 0
  }
}
