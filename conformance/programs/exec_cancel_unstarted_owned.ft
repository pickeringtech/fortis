// execute: quick|drop argument|drop captured|recovered -1
// reports: task-lifecycle:state=not_started|task-lifecycle:state=not_started
// requires: runtime
// covers: LANG-07-07
// 7.9, 12.3 (X-250; D-30): a task cancelled before it starts never runs, and what its work owns goes with it: an
// async call's owned argument, and a closure's `move` capture, each destroyed when the task is cancelled.
import fortis.host { Console }

export error Bad {
  code: "demo.bad"
}

export class Res {
  console: Shared[Console]
  label: String
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

async try func quick(console: Shared[Console]) Int {
  console.print("quick")
  fail Bad()
}

async func hold(r: owned Res) Int => r.label.scalarCount()

async try func run(console: Shared[Console]) Int {
  scope tasks {
    let first = tasks.launch(quick(console))
    let second = tasks.launch(hold(Res(console: console.retain(), label: "argument")))
    let kept = Res(console: console.retain(), label: "captured")
    let third = tasks.launchBlocking(fn once[move kept]() Int => kept.label.scalarCount())
    let x = await first or fail
    let y = await second
    let z = await third
    return Int.wrappingAdd(x, Int.wrappingAdd(y, z))
  }
}

async recovers func main(out: Console) {
  let console = Shared.create(move out)
  let r = await run(console) or recover -1
  console.print("recovered ${r}")
}
