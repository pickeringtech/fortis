// reject: E-TYP-040 (at the marked line)
// covers: LANG-11-07
// reveal takes a SecretAccess; no other capability stands in for it.
import fortis.host { Environment, Console, reveal }
func leak(env: Environment, console: Console) Int {
  return match env.get("PATH") {
    present(s) => reveal(s, console).scalarCount()   // reject: E-TYP-040 — Console is not SecretAccess
    null => 0
  }
}
