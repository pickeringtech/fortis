// execute: 5
// requires: runtime
// covers: LANG-09-07
// The matching instantiation is the constructor. `Level[Int].High` is `fn(Int) Level[Int]`.
import fortis.host { Console }

enum Level[T] {
  High(value: T)
}

func main(console: Console) {
  let f: fn(Int) Level[Int] = Level[Int].High
  let v = f(5)
  let n = match v {
    High(value) => value
  }
  console.print("${n}")
}
