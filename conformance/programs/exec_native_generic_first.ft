// execute: first a|drop a|drop b|end
// requires: runtime
// covers: LANG-06-10
// A generic function instantiated at a class with a `cleanup` builds natively (6.10, X-515; D-396): `List.first`
// declares no `Copyable` bound, so the generated signature carries no `Clone` bound either, and the lent element is
// read in place.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: label as String, console: console.retain())
}

func lentFirst(console: Shared[Console]) {
  let xs = List.of(make(console, "a"), make(console, "b"))
  let t = xs.first()
  console.print("first ${t?.label ?? "?"}")
}

func main(console: Console) {
  let shared = Shared.create(move console)
  lentFirst(shared)
  shared.print("end")
}
