// reject: E-TYP-040 (at the marked line)
// covers: LANG-11-07
// Console prints text, never a Secret's value: passing the Secret itself is refused (interpolation shows a fingerprint).
import fortis.host { Console, Secret }
func show(console: Console, s: Secret[String]) Void {
  console.print(s)                               // reject: E-TYP-040 — Secret[String] is not a StringView
}
