// execute: 3|4
// requires: runtime
// covers: LANG-07-05
import fortis.host { Console }

export class Counter {
  export count: Int
  export func bump(editable self) {
    self.count = Int.wrappingAdd(self.count, 1)
  }
}

func main(console: Console) {
  let mut counter = Counter(count: 3)
  {
    let seen = alias counter
    console.print("${seen.count}")
  }
  counter.bump()
  console.print("${counter.count}")
}
