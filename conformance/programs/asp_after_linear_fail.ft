// reject: E-OBL-008 (at the marked line)
// covers: LANG-11-09
// An `after` hook may fail only when the result is not linear: a failing after would leave it with no consumer (11.8).
export class Tx {
  witness: Must
  export func commit(owned self) {
    let Tx(witness: w) = move self
    Must.discharge(move w)
  }
}
export error Late {
  code: "demo.late"
}
export aspect checked() {
  after(result: Tx) {
    fail Late()                            // reject: E-OBL-008 — the result type Tx is linear
  }
}
@checked()
try func begin() Tx => Tx(witness: Must.create())
