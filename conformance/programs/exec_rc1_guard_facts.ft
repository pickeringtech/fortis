// execute: 1|1 100
// requires: runtime
// covers: LANG-06-02, LANG-07-06, LANG-10-01
import fortis.host { Console }
class Box { export n: Int }
func reads(x: Box) Bool => x.n >= 0
func change(x: editable Box) Bool { x.n = 100
  return true }
func restricted(n: Int<0..3>) Int => n
func main(console: Console) {
  let mut x = Box(n: 1)
  match x.n {
    0..3 when reads(x) => console.print("${restricted(x.n)}")
    otherwise => console.print("miss")
  }
  let n = x.n
  match n {
    0..3 when change(editable x) => console.print("${restricted(n)} ${x.n}")
    otherwise => console.print("miss")
  }
}
