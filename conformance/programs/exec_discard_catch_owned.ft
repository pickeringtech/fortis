// execute: drop fb|drop rec|bound b|drop b|end
// reports: runtime-failure:probe.missing|runtime-failure:probe.missing
// requires: runtime
// covers: LANG-10-04, LANG-07-07
// D-413, 7.9, 10.4: an owned value recovered by a `catch` or an `or recover` whose result the statement discards is a
// temporary of the statement, destroyed when the statement ends; one a `let` binds is destroyed with the binding. The
// VM never destroyed the value a discarded `catch` recovered, so its cleanup was lost; the interpreter and native
// code were right. The tokens sit in slots without a cleanup of their own, so that no backend announces the
// temporaries in its trace (D-344); the output shows every cleanup once.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

class Slot {
  token: Token
}

func make(console: Shared[Console], label: StringView) Slot {
  return Slot(token: Token(label: label as String, console: console.retain()))
}

error Missing {
  code: "probe.missing"
}

try func g() Slot {
  fail Missing()
}

recovers func main(out: Console) {
  let console = Shared.create(move out)
  discard (g() catch e {
    report e
    recover make(console, "fb")
  })
  discard (g() or recover make(console, "rec"))
  {
    let x = g() catch e {
      report e
      recover make(console, "b")
    }
    console.print("bound ${x.token.label}")
  }
  console.print("end")
}
