// execute: numeric.divide_by_zero|numeric.overflow|0.30
// requires: runtime
// covers: LANG-06-04
import fortis.host { Console }

try recovers func main(console: Console) {
  let q = Decimal.div(1d, 0d) catch e {
    console.print(e.code)
    recover 0d
  }
  discard q
  let big = Decimal.mul(79228162514264337593543950335d, 10d) catch e {
    console.print(e.code)
    recover 0d
  }
  discard big
  let r1 = Decimal.fromFloat(0.3, 2, HalfEven) or fail
  console.print("${r1}")
}
