// execute: 12.75 GBP
// requires: runtime
// covers: LANG-06-04
// 15: same-currency addition is exact at the larger operand scale.
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
try func main(console: Console) {
  let total = Money.add(Money.of(GBP, 10.50d), Money.of(GBP, 2.25d)) or fail
  console.print("${total.amount} ${total.currency}")
}
