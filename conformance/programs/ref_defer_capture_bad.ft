// reject: E-REF-002 (at the marked lines)
// covers: LANG-06-02, LANG-12-01
// A deferred body changes a place through a closure's `editable` capture: the closure made in the body, or made before
// and called there. The effect on the facts counts the capture as a write (D-75), so `d` is not proved non-zero.
export func made_inside() Int {
  let mut d: Int<0..1> = 0
  {
    defer {
      d = 1
      let mut clear = fn mut[editable d]() Void {
        d = 0
      }
      editable clear()
    }
  }
  return 1 / d                               // reject: E-REF-002 — the closure sets `d` to 0 after `d = 1`
}

export func made_before() Int {
  let mut d: Int<0..1> = 1
  {
    let mut clear = fn mut[editable d]() Void {
      d = 0
    }
    {
      defer {
        editable clear()
      }
    }
  }
  return 1 / d                               // reject: E-REF-002 — the deferred call sets `d` to 0
}
