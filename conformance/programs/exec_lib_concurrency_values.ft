// execute: 5|7|true|false|locked
// requires: runtime
// covers: LANG-12-06
// The atomic and mutex intrinsics on the single-threaded interpreter (12.7).
import fortis.host { Console }
try func main(console: Console) {
  let counter = AtomicInt.create(5)
  let previous = counter.fetchAdd(2)
  console.print("${previous}")
  console.print("${counter.load()}")
  let flag = AtomicBool.create(true)
  console.print("${flag.load()}")
  flag.store(false)
  console.print("${flag.load()}")
  let m = Mutex.create(1)
  {
    let g = m.lockBlocking() or fail
    console.print("locked")
  }
}
