// execute: 59.97|-19.99|0.00
// requires: runtime
// covers: LANG-06-04
// Money.multiply keeps the amount's scale (an Int factor has scale 0).
import fortis.host { Host }
import fortis.money { Money, Currency, CurrencyMismatch }
export try func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let price = Money.of(Currency.USD, 19.99d)
  let three = Money.multiply(price, 3) or fail
  let negative = Money.multiply(price, -1) or fail
  let none = Money.multiply(price, 0) or fail
  caps.console.print("${three.amount}")
  caps.console.print("${negative.amount}")
  caps.console.print("${none.amount}")
}
