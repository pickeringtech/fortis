// execute: fail:money.currency_mismatch
// requires: runtime
// covers: LANG-06-04
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
try func main(console: Console) {
  let rest = Money.subtract(Money.of(EUR, 5d), Money.of(GBP, 1d)) or fail
  console.print("${rest.amount}")
}
