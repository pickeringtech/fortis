// execute: 9
// requires: runtime
// reports: observation-frame:schema=Lookup,outcome=success
// covers: LANG-13-02
// A required observation field is assigned exactly once on every applicable exit (13).
import fortis.host { Console }

observation Lookup {
  key: Int        required: all
  found: Int      required: success
}

@observe(Lookup)
try func lookup(key: Int) Int {
  capture key = key
  let v = Int.wrappingMul(key, 3)
  capture found = v
  return v
}

try func main(console: Console) {
  let v = lookup(3) or fail
  console.print("${v}")
}
