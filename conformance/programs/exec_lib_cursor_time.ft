// execute: a|b|c|true|false
// requires: runtime
// covers: LANG-05-03
// List.iterate gives a cursor over read loans; Timestamp ordering (15).
import fortis.host { Console }
recovers func main(console: Console) {
  let letters: List[String] = List.of("a", "b", "c")
  let mut cursor = letters.iterate()
  loop {
    match cursor.next() {
      present(s) => console.print(s)
      null => {
        break
      }
    }
  }
  let start = Timestamp.epoch()
  let later = Timestamp.add(start, Duration.seconds(5)) or recover start
  console.print("${Timestamp.after(later, start)}")
  console.print("${Timestamp.before(later, start)}")
}
