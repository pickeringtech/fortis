// execute: made 1|kept|cleanup 1|after move|made 2|made 3|stop|cleanup 2|cleanup 3|after break|made 4|visit|cleanup 4|after visit
// requires: runtime
// covers: LANG-07-07
// 7.9: an element moved out of a temporary `for` source leaves that source. Elements the body does not
// move, including those still in the source when the loop breaks, are destroyed with the source.
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id, console: console.retain())
  }
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

func run(console: Shared[Console]) {
  for h in List[Handle].of(Handle.make(1, alias console)) {
    let kept = move h
    console.print("kept")
  }
  console.print("after move")
  for h in List[Handle].of(Handle.make(2, alias console), Handle.make(3, alias console)) {
    console.print("stop")
    break
  }
  console.print("after break")
  for h in List[Handle].of(Handle.make(4, alias console)) {
    console.print("visit")
  }
  console.print("after visit")
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
}
