// execute: b=2,a=1,c=3|b=2,a=1,c=3|x,y
// requires: runtime
// covers: LANG-06-06
// Map and Set iteration is deterministic per build: insertion order, the same on every run (6.6).
import fortis.host { Console }

pure func show(m: Map[String, Int]) String {
  let mut out = "" as String
  for entry in m {
    out = if out == "" { give "${entry.0}=${entry.1}" } else { give "${out},${entry.0}=${entry.1}" }
  }
  return out
}

func main(console: Console) {
  let mut m: Map[String, Int] = Map.default()
  m.set("b", 2)
  m.set("a", 1)
  m.set("c", 3)
  console.print(show(m))
  console.print(show(m))
  let mut s: Set[String] = Set.default()
  discard s.add("x")
  discard s.add("y")
  let mut items = "" as String
  for x in s {
    items = if items == "" { give copy x } else { give "${items},${x}" }
  }
  console.print(items)
}
