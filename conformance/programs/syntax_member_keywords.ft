// accept
// covers: LANG-03-04
export class Parser {
  source: String

  export pure func from(text: StringView) Parser => Parser(source: String.from(text))   // a keyword as a method name (LR 3.4)

  export pure func where(self) Int => 0
}

export pure func use(p: Parser) Int {
  return p.
    where()                                // continuation onto a member-position keyword
}
