// execute: b bt|drop bt
// requires: runtime
// covers: LANG-11-03, LANG-07-07
// D-400, 7.9, 11.3: a binding that holds a loan destroys nothing when it ends, so it is not charged the lent type's
// `cleanup` effects: `let t = alias b.t`, in a function whose result is `from b`, leaves `through` without the `io` of
// `Token`'s `cleanup`, which needs an Authority it has none of. Both checkers charged every binding of the type. The
// value is destroyed once, by its owner in `main`, on every backend. The other shape of the record, a `??` whose
// fallback fails (`let t = xs.get(0) ?? fail Missing()`), passes both checkers the same way; native code does not
// build it yet (D-445), so it stays a reproduction under conformance/known-defects/.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

class Box {
  t: Token
}

func through(b: Box) alias Token from b {
  let t = alias b.t
  return t
}

func main(out: Console) {
  let console = Shared.create(move out)
  let b = Box(t: Token(label: "bt" as String, console: console.retain()))
  console.print("b ${through(alias b).label}")
}
