// execute: recovered -1
// execute-trace: launch worker#1 on parallel|launch quick#2|suspend main|start worker#1|checkpoint worker#1|start quick#2|complete quick#2|resume main|join quick#2|loans-end|cancel worker#1|suspend main|resume worker#1|cancelled worker#1|loans-end|defer|complete worker#1|resume main|join worker#1
// requires: runtime
// covers: LANG-12-03
// 12.4: a parallel task without an await observes cancellation at checkpoint(): each checkpoint yields to the
// scheduler; the scope cancels the task while it is parked at one, and it unwinds there (its defer runs).
import fortis.host { Console }
export error Bad {
  code: "demo.bad"
}
async func worker(limit: Int) Int {
  let mut total = 0
  defer { discard total }
  let mut i = 1
  while i <= limit {
    total = Int.wrappingAdd(total, i)
    checkpoint()
    i = Int.wrappingAdd(i, 1)
  }
  return total
}
async try func quick() Int {
  fail Bad()
}
async try func run() Int {
  scope tasks {
    let w = tasks.launchParallel(worker(5))
    let q = tasks.launch(quick())
    let x = await q or fail
    return Int.wrappingAdd(x, await w)
  }
}
async recovers func main(console: Console) {
  let r = await run() or recover -1
  console.print("recovered ${r}")
}
