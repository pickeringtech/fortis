// execute: show a|show a|after|drop held2|drop held1|drop a
// execute-trace: loans-end|drop Token|drop Token
// requires: runtime
// covers: LANG-07-07, LANG-10-01
// D-453: native regression, R23.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: label as String, console: console.retain())
}

func show(console: Shared[Console], t: Token) {
  console.print("show ${t.label}")
}

export error Missing {
  code: "demo.missing"
}

try func find(xs: List[Token]) alias Token from xs {
  match xs.get(0) {
    present(t) => { return t }
    null => { fail Missing() }
  }
}

recovers func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "a"))
  let d1 = make(console, "held1")
  let d2 = make(console, "held2")
  {
    let t = find(alias xs) or recover move d1
    show(console, move t)
  }
  {
    let u = find(alias xs) catch e { recover move d2 }
    show(console, move u)
  }
  console.print("after")
}
