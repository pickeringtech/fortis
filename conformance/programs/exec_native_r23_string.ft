// execute: 9 7
// requires: runtime
// covers: LANG-09-01
// D-244: a user String, its values and its associated from method keep their identity.
import fortis.host { Console }
class String {
  value: Int
  func from(value: Int) Int => value
}
func read(value: String) Int { return value.value }
func lend(value: String) alias String from value { return alias value }
func main(console: Console) {
  let value = String(value: 7)
  console.print("${String.from(9)} ${read(lend(alias value))}")
}
