// reject: E-DEF-002 (at the marked lines)
// covers: LANG-12-01, LANG-07-04, LANG-03-06
// D-391: a deferred block that names a local only inside a string interpolation names it (3.6), so moving the local
// out afterwards, by `return t` (X-345), `return move t` or an owned argument, is E-DEF-002 exactly as the bare
// name is (12.1). Both checkers once read the holes of a deferred block for its effects but not for its places, so
// `return t` was accepted, the interpreter read the moved value and the VM stopped the deferred block silently.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func eat(t: owned Token) {
  discard t
}

func returned(console: Shared[Console]) Token {
  let t = make(console, "y")
  defer {
    console.print("read ${t.label}")
  }
  return t                                           // reject: E-DEF-002: the defer above names t in a hole
}

func returnedMarked(console: Shared[Console]) Token {
  let t = make(console, "z")
  defer {
    console.print("read ${t.label}")
  }
  return move t                                      // reject: E-DEF-002: the same, marked
}

func eaten(console: Shared[Console]) {
  let t = make(console, "w")
  defer {
    console.print("bye ${t.label}")
  }
  eat(move t)                                        // reject: E-DEF-002: moved into an owned parameter
  console.print("after")
}

func main(console: Console) {
  let shared = Shared.create(move console)
  let a = returned(shared)
  shared.print("got ${a.label}")
  let b = returnedMarked(shared)
  shared.print("got ${b.label}")
  eaten(shared)
  shared.print("end")
}
