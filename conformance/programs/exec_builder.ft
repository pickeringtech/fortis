// execute: a,b,c
// requires: runtime
// covers: LANG-06-06
import fortis.host { Console }
import fortis.text

func main(console: Console) {
  let mut out = text.Builder.create()
  let parts = List.of("a", "b", "c")
  for i in 0..<parts.count() {
    if i > 0 {
      out.append(",")
    }
    out.append(parts[i])
  }
  console.print(out.finish())
}
