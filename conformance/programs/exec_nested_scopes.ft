// execute: 1|2|3
// requires: runtime
// covers: LANG-04-05
// Shadowing is rejected, so a name means one binding in a nested block; disjoint blocks may reuse a name (4.5).
import fortis.host { Host }

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let outer = 1
  caps.console.print("${outer}")
  if outer == 1 {
    let inner = 2
    caps.console.print("${inner}")
  }
  if outer == 1 {
    let inner = 3
    caps.console.print("${inner}")
  }
}
