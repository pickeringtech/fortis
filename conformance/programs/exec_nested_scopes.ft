// execute: 1|2|3
// requires: runtime
// covers: LANG-04-05
// Shadowing is rejected, so a name means one binding in a nested block; disjoint blocks may reuse a name (4.5).
import fortis.host { Console }

func main(console: Console) {
  let outer = 1
  console.print("${outer}")
  if outer == 1 {
    let inner = 2
    console.print("${inner}")
  }
  if outer == 1 {
    let inner = 3
    console.print("${inner}")
  }
}
