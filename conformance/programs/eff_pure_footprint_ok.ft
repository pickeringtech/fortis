// accept
// covers: LANG-11-02
export class Cell {
  export value: Int
  export pure func set(editable self, value: Int) {
    self.value = value
  }
}
pure func fill(c: editable Cell, v: Int) {
  c.value = v
  c.set(v)
}
pure func build() Cell {
  let mut cell = Cell(value: 0)
  cell.set(1)
  cell.value = 2
  return cell
}
pure func collect(n: Int) List[Int] {
  let mut out: List[Int] = List.default()
  out.push(n)
  return out
}
