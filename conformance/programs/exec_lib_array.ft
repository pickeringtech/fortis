// execute: 3|[0, 0, 0]|[0, 7, 0]|7
// requires: runtime
// covers: LANG-06-07
// Array[T, N] is fixed-size; Array.filled takes N from the type (6.7).
import fortis.host { Console }
func main(console: Console) {
  let mut slots = Array[Int, 3].filled(0)
  console.print("${slots.count()}")
  console.print("${slots}")
  slots.set(1, 7)
  console.print("${slots}")
  console.print("${slots[1]}")
}
