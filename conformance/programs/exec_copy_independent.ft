// execute: 1|2|1
// requires: runtime
// covers: LANG-07-01, LANG-07-03
import fortis.host { Console }

export class Box {
  export value: Int
}

func main(console: Console) {
  let original = Box(value: 1)
  let mut copied = copy original
  copied.value = 2
  console.print("${original.value}")
  console.print("${copied.value}")
  let moved = move copied
  console.print("${Int.wrappingSub(moved.value, 1)}")
}
