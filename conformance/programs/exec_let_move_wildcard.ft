// execute: made 1|made 2|cleanup 2|after 1|cleanup 1|made 1|made 2|cleanup 1|cleanup 2|after
// execute-trace: loans-end|drop Handle
// requires: runtime
// covers: LANG-09-06, LANG-07-07
// 9.8, 7.9: `let Name(field: p, other: _) = move place` consumes the place. The discarded field is destroyed at
// the let, with no `drop` trace, and the binding is destroyed at the end of the block, after loans end. A pattern
// that binds nothing still consumes the place: every field matched by `_` is destroyed at the let, in declaration
// order, and the let traces nothing.
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id, console: console.retain())
  }
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

export class Pair {
  export first: Handle
  export second: Handle
}

func bound(console: Shared[Console]) {
  let p = Pair(first: Handle.make(1, alias console), second: Handle.make(2, alias console))
  let Pair(first: a, second: _) = move p
  console.print("after ${a.id}")
}

func allWild(console: Shared[Console]) {
  let p = Pair(first: Handle.make(1, alias console), second: Handle.make(2, alias console))
  let Pair(first: _, second: _) = move p
  console.print("after")
}

func run(console: Shared[Console]) {
  bound(alias console)
  allWild(alias console)
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
}
