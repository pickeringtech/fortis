// execute: got mapped|shown mapped|fallback spare|entry|after lookups|local local|drop local|end|drop spare|drop mapped
// reports: log:level=info,message=drop local,function=cleanup Token|log:level=info,message=drop spare,function=cleanup Token|log:level=info,message=drop mapped,function=cleanup Token
// requires: runtime
// covers: LANG-07-07, LANG-07-05
// D-338, 7.9, 12.2: `m.get(k)` lends the map's value. A binding of that loan, a loan passed to an optional read
// parameter, a `??` of it and a loop over the map's entries own nothing, so each value's cleanup runs once, when the
// map's owner ends. The interpreter and the VM ran it again when the binding ended, and native code copied the
// value and ran the copy's cleanup.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
    log.info("drop ${self.label}")
  }
}

func show(console: Shared[Console], t: Token?) {
  console.print("shown ${t?.label ?? "none"}")
}

func lookUp(console: Shared[Console], m: Map[String, Token], d: Token) {
  let t = m.get("k")
  if t != null {
    console.print("got ${t.label}")
  }
  show(console, m.get("k"))
  let u = m.get("absent") ?? alias d
  console.print("fallback ${u.label}")
  for e in m {
    console.print("entry")
  }
  console.print("after lookups")
}

func sameBlock(console: Shared[Console]) {
  let mut m: Map[String, Token] = Map.default()
  m.set(String.from("k"), Token(label: String.from("local"), console: console.retain()))
  let t = m.get("k")
  console.print("local ${t?.label ?? "none"}")
}

func main(out: Console) {
  let console = Shared.create(move out)
  let mut m: Map[String, Token] = Map.default()
  m.set(String.from("k"), Token(label: String.from("mapped"), console: console.retain()))
  let d = Token(label: String.from("spare"), console: console.retain())
  lookUp(console, m, d)
  sameBlock(console)
  console.print("end")
}
