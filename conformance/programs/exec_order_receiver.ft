// execute: receiver|arg a|arg b|call
// requires: runtime
// covers: LANG-05-07
// 5.7: the receiver of a method call is evaluated before its arguments, left to right, exactly once.
import fortis.host { Console }
export class Probe {
  export console: Shared[Console]
  export func make(console: Shared[Console], label: StringView) Probe {
    console.print(label)
    return Probe(console: console.retain())
  }
  export func call(self, a: Int, b: Int) {
    self.console.print("call")
  }
}
func tick(console: Shared[Console], label: StringView, v: Int) Int {
  console.print(label)
  return v
}
func main(out: Console) {
  let console = Shared.create(move out)
  Probe.make(alias console, "receiver").call(tick(console, "arg a", 1), tick(console, "arg b", 2))
}
