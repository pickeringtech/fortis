// execute: 14|20|true|false|7|-6
// requires: runtime
// covers: LANG-05-06
// Precedence and associativity follow 5.6: multiplication before addition, comparison after arithmetic, `&&` before
// `||`, unary minus binding tightest, left associativity for subtraction.
import fortis.host { Console }

func main(console: Console) {
  console.print("${2 + 3 * 4}")
  console.print("${(2 + 3) * 4}")
  console.print("${1 + 1 == 2 && 3 > 2 || false}")
  console.print("${false && true || false}")
  console.print("${10 - 2 - 1}")
  console.print("${-2 * 3}")
}
