// execute: slept|3|done
// execute-trace: suspend main|time 1ms|launch step#1|launch step#2|suspend main|start step#1|suspend step#1|start step#2|suspend step#2|time 2ms|resume step#1|complete step#1|resume main|join step#1|suspend main|resume step#2|complete step#2|resume main|join step#2
// requires: runtime
// covers: LANG-11-03
// SP-04-async adapter review, supplementary to the preregistered workload: the executor's trusted intrinsics a
// `noalloc` async function reaches (a sleep that suspends, inline awaits, `join`) allocate in no phase.
import fortis.host { Host, Clock }
noalloc async func nap(clock: Clock) Void {
  await clock.sleep(1ms)
}
noalloc async func step(clock: Clock, n: Int) Int {
  await nap(clock)
  return n
}
noalloc async func pair(clock: Clock) Int {
  let both = await join(step(clock, 1), step(clock, 2))
  let (a, b) = move both
  return Int.wrappingAdd(a, b)
}
export async func main(args: List[String]) Void {
  let caps = Host.capabilities()
  await nap(caps.clock)
  caps.console.print("slept")
  let s = await pair(caps.clock)
  caps.console.print("${s}")
  caps.console.print("done")
}
