// reject: E-OWN-001 (at the marked lines)
// covers: LANG-07-01
export class User {
  export name: String
  export age: Int
  export func rename(editable self, name: String) Void {
    self.name = copy name
  }
  export func retire(owned self) Int => self.age
}

func keep(user: owned User) Void {
}

func change(user: editable User) Void {
}

func positions(name: String, user: User) User {
  let other = user                                   // reject: E-OWN-001 — let needs copy/alias/move
  let mut own = User(name: copy name, age: 1)
  own = user                                         // reject: E-OWN-001 — assignment needs a marker
  let built = User(name: name, age: 2)               // reject: E-OWN-001 — field initialiser needs a marker
  change(own)                                        // reject: E-OWN-001 — editable parameter needs `editable own`
  keep(own)                                          // reject: E-OWN-001 — owned parameter needs move or copy
  keep(alias own)                                    // reject: E-OWN-001 — alias is not a transfer
  change(move own)                                   // reject: E-OWN-001 — editable parameter takes `editable`
  own.rename("z")                                    // reject: E-OWN-001 — editable self receiver needs `editable own.rename`
  let age = own.retire()                             // reject: E-OWN-001 — owned self receiver needs `move own.retire`
  let bad = editable user                            // reject: E-OWN-001 — editable needs a mutable root
  let taken = move user                              // reject: E-OWN-001 — a plain parameter holds a loan and owns nothing
  return user                                        // reject: E-OWN-001 — return needs move/copy or a from signature
}
