// accept
// covers: LANG-07-05
// A loan held by a binding lasts until the end of the block that declares it; closing the block ends it (7.3).
export class Invoice {
  export lines: List[Int]
  export func issue(editable self) {
  }
}

func sequence(invoice: editable Invoice) {
  {
    let lines = alias invoice.lines
    discard lines.count()
  }
  invoice.issue()
}
