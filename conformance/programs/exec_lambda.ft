// execute: 6|3
// requires: runtime
// covers: LANG-08-02
import fortis.host { Console }

func main(console: Console) {
  let doubled = List.of(1, 2, 3).map(fn(x: Int) Int => Int.wrappingMul(x, 2))
  console.print("${doubled.get(2) ?? 0}")
  let evens = List.of(1, 2, 3, 4, 5, 6).countWhere(fn(x: Int) Bool => x % 2 == 0)
  console.print("${evens}")
}
