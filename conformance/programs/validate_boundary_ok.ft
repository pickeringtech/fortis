// accept
// covers: LANG-06-03
// `as` is the explicit fallible conversion into a refined or nominal type (6.3, 6.13).
export type UserId = Int<1..>

try func parse(raw: Int) UserId {
  let id = raw as UserId or fail
  return id
}

try func percent(raw: Int) Int<0..100> => raw as Int<0..100> or fail
