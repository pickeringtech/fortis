// reject: E-OWN-010 (at the marked lines)
// covers: LANG-07-04, LANG-07-05
// D-362, 7.3: a loan is live at a join if it is live on any incoming path. A loop's exit joins the paths that leave
// it: the header with its condition false, before the body has run or after any iteration (a `continue` included),
// and every `break`. A body that ends a loan a `let mut` binding holds inside an optional (`t = null`) ends it on its
// own path only, so the owner is still lent after the loop. Both checkers took the body's end for the loop's, so
// the interpreter and the VM read an element after `pop` took it out of the list; native code did not build.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func skipped(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "item"))
  let mut t = xs.get(0)
  let go = false
  while go {
    t = null
  }
  let v = xs.pop()                                                        // reject: E-OWN-010 — the body may not run
  console.print("t ${t?.label ?? "none"} v ${v?.label ?? "none"}")
}

func empty(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "item"))
  let mut t = xs.get(0)
  for i in 0..<0 {
    t = null
  }
  let v = xs.pop()                                                        // reject: E-OWN-010 — a `for` over nothing
  console.print("t ${t?.label ?? "none"} v ${v?.label ?? "none"}")
}

func broken(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "item"))
  let mut t = xs.get(0)
  let mut i = 0
  while i < 2 {
    t = xs.get(0)
    if i == 1 {
      break
    }
    t = null
    i = i + 1
  }
  let v = xs.pop()                                                        // reject: E-OWN-010 — the `break` leaves with the loan live
  console.print("t ${t?.label ?? "none"} v ${v?.label ?? "none"}")
}

func continued(console: Shared[Console]) {
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "item"))
  let mut t = xs.get(0)
  t = null
  let mut i = 0
  while i < 2 {
    i = i + 1
    t = xs.get(0)
    if i == 2 {
      continue
    }
    t = null
  }
  let v = xs.pop()                                                        // reject: E-OWN-010 — the `continue` reaches the header with the loan live
  console.print("t ${t?.label ?? "none"} v ${v?.label ?? "none"}")
}

func main(out: Console) {
  let console = Shared.create(move out)
  skipped(console)
  empty(console)
  broken(console)
  continued(console)
  console.print("end")
}
