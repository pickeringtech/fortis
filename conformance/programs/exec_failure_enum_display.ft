// execute: odd|even
// requires: runtime
// covers: LANG-10-01
// A payload-free enum stored in a failure keeps its variant when `display` is not the variant's name
// (D-55). Matching `is` rebuilds the variant, and the custom display is not the discriminant.
import fortis.host { Host, Console, Capabilities }
import fortis.text { Builder }

export enum Kind implements Displayable {
  Odd
  Even
  export pure func display(self, into: editable Builder) Void {
    editable into.append("custom")
  }
}

export error Bad {
  code: "demo.bad"
  payload { kind: Kind }
}

try func classify(k: Kind) Int {
  fail Bad(kind: k)
}

recovers func word(k: Kind) String {
  return match classify(k) {
    success(_) => "no"
    failure(f) => match move f {
      is Bad(kind: found) => match found {
        Odd => "odd"
        Even => "even"
      }
      otherwise(other) => {
        report other
        give "no"
      }
    }
  }
}

export recovers func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let Capabilities(console: out, fileSystem: fs, network: net, clock: clock, random: rnd, environment: env, process: proc, supervisor: sup, secretAccess: sec, rawSql: sql) = move caps
  out.print(word(Kind.Odd))
  out.print(word(Kind.Even))
}
