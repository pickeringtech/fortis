// reject: E-EFF-001 (at the marked lines)
// covers: LANG-11-01, LANG-11-03
// D-143: an effect whose site is inside an interpolation hole is reported at the hole's place in the file; the reference
// checker reported it at the hole's own first line and column (1:1), so the two checkers disagreed.
import fortis.host { Console }

func loud(console: Console) Int {
  console.print("x")
  return 1
}

pure func quiet(console: Console) {
  let s = "value ${loud(console)}"         // reject: E-EFF-001 — io inside a hole of a pure function
}

noalloc func lean() Int {
  let s = "n ${String.from("a")}"          // reject: E-EFF-001 — an allocation inside a hole of a noalloc function
  return 1
}

func main(console: Console) {
  quiet(console)
}
