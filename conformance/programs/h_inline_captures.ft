// execute: Latte|Tea|2|1|3|Hello, Ada
// requires: runtime
// covers: LANG-08-01, LANG-08-02, LANG-08-03, LANG-08-04
import fortis.host { Console }
class Drink {
  name: String
  cost: Int
  func label(self) StringView from self => alias self.name
  func price(self) Int => self.cost
}
func main(console: Console) {
  let drinks = List.of(Drink(name: "Latte", cost: 4), Drink(name: "Tea", cost: 2))
  drinks.each(fn(drink) => console.print(drink.label()))
  let mut labels: List[String] = List.default()
  drinks.each(fn(drink) { labels.push(drink.label() as String) })
  console.print("${labels.count()}")
  let limit = 3
  let cheap = drinks.filter(fn(drink) => drink.price() < limit)
  console.print("${cheap.count()}")
  cheap.each(fn mut[editable labels](drink) Void { labels.push(drink.label() as String) })
  console.print("${labels.count()}")
  let prefix: String = "Hello"
  let greet = fn[alias prefix](name: StringView) String => "${prefix}, ${name}"
  console.print(greet("Ada"))
}
