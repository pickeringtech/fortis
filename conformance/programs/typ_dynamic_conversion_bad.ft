// reject: E-TYP-040 (at the marked lines)
// covers: LANG-09-07
// A value converts to `dynamic I` only from a type that implements `I` with the written arguments, from a type
// parameter whose bound grants `I`, or from a `dynamic J` where `J` is `I` or requires it (9.5). Each line here does
// none of those; the checkers used to accept them all.
import fortis.host { Host }

export interface Measured {
  pure func size(self) Int
}

export interface Named {
  pure func name(self) String
}

export interface Part[A] {
  pure func item(self) A
}

export class Pair implements Measured {
  export a: Int
  pure func size(self) Int => self.a
}

export class Label implements Named {
  export text: String
  pure func name(self) String => copy self.text
}

export class IntBox implements Part[Int] {
  export v: Int
  pure func item(self) Int => self.v
}

func measure(m: dynamic Measured) Int => m.size()

func title(n: dynamic Named) String => n.name()

func intItem(x: dynamic Part[String]) String => x.item()

func wrap[T](x: owned T) dynamic Measured where T implements Named => move x    // reject: E-TYP-040

func pass(n: dynamic Named) Int => measure(n)                                   // reject: E-TYP-040

export func main(args: List[String]) {
  let caps = Host.capabilities()
  caps.console.print("${measure(Label(text: "a"))}")                             // reject: E-TYP-040
  let d: dynamic Measured = Label(text: "b")                                    // reject: E-TYP-040
  caps.console.print(intItem(IntBox(v: 1)))                                     // reject: E-TYP-040
  caps.console.print(title(Pair(a: 1)))                                         // reject: E-TYP-040
}
