// execute: failure.aggregate|done
// reports: runtime-failure:code=failure.aggregate|runtime-failure:annotations=['loading account']
// requires: runtime
// covers: LANG-10-03
// annotate keeps the single obligation and adds a note; Failures.aggregate makes one failure of many (10.6).
import fortis.host { Host }
export error Odd {
  code: "demo.odd"
}
try func check(n: Int) Int {
  if n % 2 == 1 {
    fail Odd()
  }
  return n
}
export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let mut failures: List[Failure] = List.default()
  for i in List.of(1, 3) {
    match check(i) {
      success(v) => {
        discard v
      }
      failure(f) => {
        editable failures.push(move f)
      }
    }
  }
  let all = Failures.aggregate(move failures)
  caps.console.print(all.code)
  report all
  let one = check(5) catch e {
    report annotate(move e, "loading account")
    recover 0
  }
  caps.console.print("done")
}
