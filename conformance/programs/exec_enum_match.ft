// execute: draft|paid 42|void: duplicate
// requires: runtime
// covers: LANG-09-05
import fortis.host { Console }

export enum Status {
  Draft
  Paid(amount: Int)
  Voided(reason: String)
}

pure func describe(status: Status) String {
  return match status {
    Draft => "draft"
    Paid(amount: a) => "paid ${a}"
    Voided(reason: why) => "void: ${why}"
  }
}

func main(console: Console) {
  console.print(describe(Draft))
  console.print(describe(Paid(amount: 42)))
  console.print(describe(Voided(reason: "duplicate")))
}
