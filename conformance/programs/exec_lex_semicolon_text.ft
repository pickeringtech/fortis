// execute: a;b|//not a comment|3
// requires: runtime
// covers: LANG-03-01
// A `;` inside a string or a comment is text, not a token; only one outside them is an error (3.1).
import fortis.host { Console }

func main(console: Console) {
  console.print("a;b")              // a comment may hold a ; too
  console.print("//not a comment")
  console.print("${Int.wrappingAdd(1, 2)}")
}
