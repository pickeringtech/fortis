// reject: E-OWN-051
// covers: LANG-07-06, LANG-08-02
func keep(flag: Bool) dynamic fn() Int {
  let n = 1
  let s = "hello" as String
  let a: dynamic fn() Int = fn[move n]() Int => n
  let b: dynamic fn() Int = fn[alias s]() Int => s.byteCount()
  let f: dynamic fn() Int = if flag { give move a } else { give move b }
  return move f
}
