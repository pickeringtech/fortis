// execute: [3, 2, 1]|[1, 2, 3, 4, 5]|2|[2, 4]|[10, 20, 30]|true|false|1
// requires: runtime
// covers: LANG-08-04
// The List operations with Fortis bodies (DEL-26): reversed, concat, countWhere, filter, map, isEmpty, first.
import fortis.host { Console }
func main(console: Console) {
  let xs = List.of(1, 2, 3)
  console.print("${xs.reversed()}")
  console.print("${xs.concat(List.of(4, 5))}")
  let four = List.of(1, 2, 3, 4)
  console.print("${four.countWhere(fn(n: Int) Bool => n % 2 == 0)}")
  console.print("${four.filter(fn(n: Int) Bool => n % 2 == 0)}")
  console.print("${xs.map(fn(n: Int) Int => Int.wrappingMul(n, 10))}")
  let none: List[Int] = List.default()
  console.print("${none.isEmpty()}")
  console.print("${xs.isEmpty()}")
  console.print("${xs.first() ?? 0}")
}
