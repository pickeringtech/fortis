// execute: work|done
// reports: runtime-failure:code=demo.flush,reported_by=cleanup
// requires: runtime
// covers: LANG-12-02
// A failure reported from a deferred block reaches the reporter labelled as raised during cleanup (12.1).
import fortis.host { Console }
export error FlushFailed {
  code: "demo.flush"
}
try func flush() {
  fail FlushFailed()
}
func work(console: Console) {
  defer {
    flush() catch e {
      report e
      recover Void
    }
  }
  console.print("work")
}
func main(console: Console) {
  work(console)
  console.print("done")
}
