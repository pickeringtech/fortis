// execute: c,a,b|c=30,a=1,b=2|9,-4,7
// requires: runtime
// covers: LANG-06-06
// Map and Set iterate in first-insertion order; replacing a value keeps its key's position (6.6).
import fortis.host { Console }
func main(console: Console) {
  let mut names: Set[String] = Set.default()
  discard names.add("c")
  discard names.add("a")
  discard names.add("c")
  discard names.add("b")
  let mut ages: Map[String, Int] = Map.default()
  ages.set("c", 3)
  ages.set("a", 1)
  ages.set("b", 2)
  ages.set("c", 30)
  let mut numbers: Set[Int] = Set.default()
  discard numbers.add(9)
  discard numbers.add(-4)
  discard numbers.add(7)
  discard numbers.add(9)
  let mut a = ""
  let mut sep = ""
  for n in names {
    a = "${a}${sep}${n}"
    sep = ","
  }
  let mut b = ""
  sep = ""
  for entry in move ages {
    let (k, v) = move entry
    b = "${b}${sep}${k}=${v}"
    sep = ","
  }
  let mut c = ""
  sep = ""
  for n in numbers {
    c = "${c}${sep}${n}"
    sep = ","
  }
  console.print(a)
  console.print(b)
  console.print(c)
}
