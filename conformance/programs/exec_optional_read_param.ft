// execute: sum 6|sum 6|head 1|none|label ab|label ab|label -|first 6|tag 1|depth 6|lambda 1|lambda 0|shape 1|shape 4|fallback 2 1|value 1 9|lazy 1|made|lazy 7|other 1 2|narrowed 2 0|generic 1 1|text 2 3|choose ab abc
// requires: runtime
// covers: LANG-06-08
// D-2: a place that is not trivial, passed where an optional is read (6.8, present injection), is lent, not moved,
// so it is still there afterwards: a class value, a string, a nested optional field, a temporary, `null`, an
// optional parameter passed on, narrowed, copied, matched, coalesced with `??`, and read by a lambda and an
// interface method.
import fortis.host { Console }

export class Node {
  export value: Int
  export next: Node?
}

export class Tag {
  export name: String
}

export interface Shape {
  func size(self, n: Node?) Int
}

export class Square implements Shape {
  export side: Int
  export func size(self, n: Node?) Int {
    if n != null {
      return n.value
    }
    return self.side
  }
}

pure func sum(n: Node?) Int {
  return match n {
    present(node) => Int.wrappingAdd(node.value, sum(node.next))
    null => 0
  }
}

pure func head(n: Node?) String {
  if n != null {
    return "head ${n.value}"
  }
  return "none"
}

pure func label(s: String?) String {
  return match s {
    present(t) => "label ${t}"
    null => "label -"
  }
}

pure func passOn(n: Node?) Int => sum(n)

pure func fallback(s: String?) Int => (s ?? "x").scalarCount()

pure func valueOr(n: Node?) Int => (n ?? Node(value: 9, next: null)).value

export class Boxy {
  export n: Int
  export lock: Mutex[Int]
}

func makeBoxy(console: Console) Boxy {
  console.print("made")
  return Boxy(n: 7, lock: Mutex.create(0))
}

func lazy(b: Boxy?, console: Console) Int => (b ?? makeBoxy(console)).n

func useBoxy(b: Boxy) Int => b.n

func orOther(b: Boxy?, other: Boxy) Int => useBoxy(b ?? other)

pure func length(s: String) Int => s.scalarCount()

pure func maybeLength(s: String?) Int {
  if s != null {
    return length(s)
  }
  return 0
}

pure func readAny[T](x: T) Int => 1

pure func viaGeneric(s: String?) Int => readAny(s)

pure func textOr(s: String?, other: String) Int => (s ?? other).scalarCount()

func choose(s: String?) String {
  let other = "abc" as String
  return copy s ?? other                               // a read parameter's text is copied to be returned (D-341)
}

func tagCopy(t: Tag?) Tag? => copy t

pure func make() Node? => Node(value: 1, next: Node(value: 2, next: Node(value: 3, next: null)))

func first(n: Node?) Int {
  if n != null {
    return n.value
  }
  return 0
}

func main(console: Console) {
  let list = Node(value: 1, next: Node(value: 2, next: Node(value: 3, next: null)))
  console.print("sum ${sum(list)}")
  console.print("sum ${sum(list)}")
  console.print(head(list))
  console.print(head(null))
  let name = "ab" as String
  console.print(label(name))
  console.print(label(name))
  console.print(label(null))
  console.print("first ${passOn(list)}")
  let tag = Tag(name: "x" as String)
  let copied = tagCopy(tag)
  let shown = match copied {
    present(t) => t.name.scalarCount()
    null => 0
  }
  console.print("tag ${shown}")
  console.print("depth ${sum(make())}")
  let probe = fn(n: Node?) Int => first(n)
  console.print("lambda ${probe(list)}")
  console.print("lambda ${probe(null)}")
  let s = Square(side: 4)
  console.print("shape ${s.size(list)}")
  console.print("shape ${s.size(null)}")
  console.print("fallback ${fallback(name)} ${fallback(null)}")
  console.print("value ${valueOr(list)} ${valueOr(null)}")
  let boxy = Boxy(n: 1, lock: Mutex.create(0))
  let given = lazy(boxy, console)
  console.print("lazy ${given}")
  let second = lazy(null, console)
  console.print("lazy ${second}")
  let other = Boxy(n: 2, lock: Mutex.create(0))
  let o1 = orOther(boxy, other)
  let o2 = orOther(null, other)
  console.print("other ${o1} ${o2}")
  console.print("narrowed ${maybeLength(name)} ${maybeLength(null)}")
  console.print("generic ${viaGeneric(name)} ${viaGeneric(null)}")
  let fallbackText = "abc" as String
  console.print("text ${textOr(name, fallbackText)} ${textOr(null, fallbackText)}")
  let chosen = choose(name)
  let fallen = choose(null)
  console.print("choose ${chosen} ${fallen}")
}
