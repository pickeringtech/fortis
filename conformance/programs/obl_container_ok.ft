// accept
// covers: LANG-10-02
// A List of outcomes is linear; Outcome.collect(move list) consumes all inputs (10.7).
try func half(n: Int) Int => n

try func both(a: Int, b: Int) List[Int] {
  let mut results: List[Outcome[Int]] = List.default()
  results.push(half(a))
  results.push(half(b))
  let values = Outcome.collect(move results) or fail
  return values
}
