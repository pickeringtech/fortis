// execute: end|drop spare|drop held
// execute-trace: loans-end|drop Token
// requires: runtime
// covers: LANG-07-07, LANG-05-07
// D-454, LR 7.9: a discarded recovery keeps a successful loan alive without owning it.
// Its fallback is not evaluated and the list destroys the borrowed element at block exit.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: label as String, console: console.retain())
}

export error Missing {
  code: "demo.missing"
}

try func find(xs: List[Token]) alias Token from xs {
  match xs.get(0) {
    present(t) => { return t }
    null => { fail Missing() }
  }
}

recovers func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "held"))
  let spare = make(console, "spare")
  discard find(alias xs) or recover move spare
  console.print("end")
}
