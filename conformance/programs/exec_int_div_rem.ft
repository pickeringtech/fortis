// execute: -3|-1|1|-9223372036854775808|9223372036854775807|-9223372036854775808
// requires: runtime
// covers: LANG-06-04
import fortis.host { Console }

try func main(console: Console) {
  let r1 = Int.div(7, -2) or fail
  console.print("${r1}")
  let r2 = Int.rem(-7, 2) or fail
  console.print("${r2}")
  let r3 = Int.rem(7, -2) or fail
  console.print("${r3}")
  console.print("${Int.wrappingAdd(9223372036854775807, 1)}")
  console.print("${Int.saturatingAdd(9223372036854775807, 1)}")
  console.print("${Int.saturatingSub(-9223372036854775807, 2)}")
}
