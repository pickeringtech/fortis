// execute: 3|6|3|6
// requires: runtime
// covers: LANG-09-03, LANG-11-03
// D-61: an implementation that writes the interface member's claims, directly or through its own contract, satisfies
// them; its body is then checked against them, so a caller through the interface may rely on `noalloc` and `pure`:
// here through `alias dynamic Measured` and through a `where` bound, on every backend (D-148).
import fortis.host { Console }

export contract Lean {
  pure
  noalloc
}

export interface Measured {
  pure noalloc func size(self) Int
}

export class Pair implements Measured {
  export left: Int
  export right: Int
  pure noalloc func size(self) Int => 2 + 1
}

export class Triple implements Measured {
  export first: Int
  Lean func size(self) Int => 6
}

pure noalloc func viaDynamic(m: alias dynamic Measured) Int => m.size()

pure noalloc func viaBound[T](m: T) Int where T implements Measured => m.size()

func main(console: Console) {
  let p = Pair(left: 1, right: 2)
  let t = Triple(first: 1)
  console.print("${p.size()}")
  console.print("${t.size()}")
  console.print("${viaDynamic(p)}")
  console.print("${viaBound(t)}")
}
