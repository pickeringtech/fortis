// reject: E-NAM-001 (at the marked line)
// covers: LANG-04-06
// 4.6's entry signature names the prelude's Void. A module-level enum of that spelling matches the tokens and is
// still not one of the forms (D-51.2). The body returns that enum, so the only finding is the entry check.
export enum Void {
  Unit
}

export func main(args: List[String]) Void {    // reject: E-NAM-001 — main's Void is not the prelude Void
  return Void.Unit
}
