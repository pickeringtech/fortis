// execute: big even|small|big odd
// requires: runtime
// covers: LANG-09-05
import fortis.host { Console }

pure func classify(n: Int) String {
  return match n {
    v when v > 10 && v % 2 == 0 => "big even"
    v when v > 10 => "big odd"
    _ => "small"
  }
}

func main(console: Console) {
  console.print(classify(12))
  console.print(classify(3))
  console.print(classify(13))
}
