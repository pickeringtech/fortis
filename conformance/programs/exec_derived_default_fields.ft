// execute: 0 false 0.0 0s [] 0 0 null 0 3|[] true|2
// requires: runtime
// covers: LANG-06-07
// 6.10 (X-345): `derive Default` gives `Name.default()`, which takes no arguments: each field at its initialiser, and a
// field without one at its type's default (`false`, `0`, `0.0`, `0s`, empty text and collections, `null`), a class
// field at that class's own derived `default()`. A field that starts otherwise is written with its initialiser.
import fortis.host { Console }

class Totals derive Default {
  count: Int
  names: List[String]
}

class Parser derive Default {
  count: Int
  open: Bool
  ratio: Float
  wait: Duration
  label: String
  seen: Map[String, Int]
  unique: Set[Int]
  last: Int?
  score: Int<0..10>
  limit: Int = 3
  totals: Totals
}

func main(console: Console) {
  let mut p = Parser.default()
  console.print("${p.count} ${p.open} ${p.ratio} ${p.wait} ${p.label}[] ${p.seen.count()} ${p.unique.count()} ${p.last} ${p.score} ${p.limit}")
  console.print("${p.totals.names} ${p.totals.names.isEmpty()}")
  p.count = 2
  console.print("${p.count}")
}
