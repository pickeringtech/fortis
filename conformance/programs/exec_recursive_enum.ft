// execute: nested 1|deeper 2|guard 1|record 1|newtype 1
// requires: runtime
// covers: LANG-09-05
// A recursive enum is boxed on every variant field that reaches it by value, including through a record or a
// newtype (D-55). A nested pattern and a consuming match's guard see the payload, not the box.
import fortis.host { Host }

export enum E derive Equatable {
  End
  Next(tail: E)
}

export enum R {
  End
  Next(tail: { inner: R })
}

type W = N

export enum N {
  End
  Next(tail: W)
}

pure func nested(e: E) Int {
  return match e {
    End => 0
    Next(tail: End) => 1
    Next(tail: Next(tail: End)) => 2
    Next(tail: _) => 3
  }
}

func taken(e: owned E) Int {
  return match move e {
    End => 0
    Next(tail: x) when x == E.End => 1
    Next(tail: _) => 2
  }
}

pure func recorded(e: R) Int {
  return match e {
    End => 0
    Next(tail: { inner: End }) => 1
    Next(tail: { inner: _ }) => 2
  }
}

pure func wrapped(e: N) Int {
  return match e {
    End => 1
    Next(tail: _) => 2
  }
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print("nested ${nested(E.Next(tail: E.End))}")
  caps.console.print("deeper ${nested(E.Next(tail: E.Next(tail: E.End)))}")
  caps.console.print("guard ${taken(E.Next(tail: E.End))}")
  caps.console.print("record ${recorded(R.Next(tail: {inner: R.End}))}")
  caps.console.print("newtype ${wrapped(N.End)}")
}
