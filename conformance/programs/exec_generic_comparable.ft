// execute: 8|b
// requires: runtime
// covers: LANG-06-10
// A generic function bounded by `Comparable` compares with `<` and `>` on every backend (6.10, X-515; D-55.4): the
// bound lowers to `PartialOrd`, at an `Int` and at a `String`.
import fortis.host { Console }

pure func pick[T](a: T, b: T) T where T implements Comparable, T implements Copyable {
  if a > b {
    return copy a
  }
  return copy b
}

func main(console: Console) {
  console.print("${pick(3, 8)}")
  console.print(pick("a" as String, "b" as String))
}
