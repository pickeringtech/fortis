// reject: E-EFF-010 (at the marked line)
// covers: LANG-11-07
// reveal needs a SecretAccess value; a function without one in its signature cannot mint one.
import fortis.host { Host, Environment, reveal }
func leak(env: Environment) Int {
  let caps = Host.capabilities()                  // reject: E-EFF-010 — Host.capabilities() outside main
  return match env.get("PATH") {
    present(s) => reveal(s, caps.secretAccess).scalarCount()
    null => 0
  }
}
func main() {
}
