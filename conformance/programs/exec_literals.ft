// execute: 255|10|15|1000000|2000.0|3.0|1.5|19.99|10|250ms|2min|true
// requires: runtime
// covers: LANG-03-05
import fortis.host { Console }

func main(console: Console) {
  console.print("${0xFF}")
  console.print("${0b1010}")
  console.print("${0o17}")
  console.print("${1_000_000}")
  console.print("${2e3}")
  console.print("${3.0f32}")
  console.print("${1.5}")
  console.print("${19.99d}")
  console.print("${10d}")
  console.print("${250ms}")
  console.print("${2min}")
  console.print("${true}")
}
