// execute: tag #ada|level <high>|level <low 2>|pair Pair(first: #ada, level: <high>)|list [#ada, #bob]|plain Plain(n: 1)|counter 4|painter 5
// requires: runtime
// covers: LANG-03-05
// D-83: interpolation writes a value through its type's `Displayable` (3.6, 11.1): a class or enum that implements
// it by hand shows what its own `display` appends, also as a field of a derived display and an item of a list. A
// type without a hand-written `display` keeps the derived form, and a method that is merely named `display` (not
// Displayable's) is an ordinary method.
import fortis.host { Console }
import fortis.text { Builder }

export class Tag implements Displayable {
  export name: String
  export pure func display(self, into: editable Builder) {
    into.append("#")
    into.append(self.name)
  }
}

export enum Level implements Displayable {
  High
  Low(depth: Int)

  export pure func display(self, into: editable Builder) {
    match self {
      High => into.append("<high>")
      Low(depth: d) => into.append("<low ${d}>")
    }
  }
}

export class Pair derive Displayable {
  export first: Tag
  export level: Level
}

export class Plain derive Displayable {
  export n: Int
}

export class Painter {
  export n: Int
  export func display(editable self, into: editable Builder) {
    self.n = Int.wrappingAdd(self.n, 1)
    into.append("painted")
  }
}

export class Counter {
  export n: Int
  export func display(self) Int => self.n
}

func main(console: Console) {
  let t = Tag(name: "ada" as String)
  console.print("tag ${t}")
  let high = Level.High
  console.print("level ${high}")
  let low: Level = Low(depth: 2)
  console.print("level ${low}")
  let p = Pair(first: Tag(name: "ada" as String), level: High)
  console.print("pair ${p}")
  let tags = List.of(Tag(name: "ada" as String), Tag(name: "bob" as String))
  console.print("list ${tags}")
  console.print("plain ${Plain(n: 1)}")
  let counter = Counter(n: 4)
  console.print("counter ${counter.display()}")
  let mut painter = Painter(n: 4)
  let mut b = Builder.create()
  painter.display(editable b)
  console.print("painter ${painter.n}")
}
