// execute: recovered|after
// requires: runtime
// covers: LANG-10-03
import fortis.host { Host }

export error Glitch {
  code: "demo.glitch"
}

try func flaky() Int {
  fail Glitch()
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let v = flaky() catch e {
    report e
    recover 1
  }
  if v == 1 {
    caps.console.print("recovered")
  }
  caps.console.print("after")
}
