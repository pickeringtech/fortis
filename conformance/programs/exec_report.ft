// execute: recovered|after
// requires: runtime
// covers: LANG-10-03
import fortis.host { Console }

export error Glitch {
  code: "demo.glitch"
}

try func flaky() Int {
  fail Glitch()
}

func main(console: Console) {
  let v = flaky() catch e {
    report e
    recover 1
  }
  if v == 1 {
    console.print("recovered")
  }
  console.print("after")
}
