// execute: one|two|three|defect:contract_violation
// requires: runtime
// covers: LANG-10-06
// A defect ends the program (10.8), and the console lines printed before it stay printed: `fortis run` once
// buffered them and lost them when the run ended in a defect (D-53).
import fortis.host { Console }

func say(console: Console, line: String) {
  console.print(line)
}

func main(console: Console) {
  console.print("one")
  say(console, "two")
  console.print("three")
  injectDefect("contract_violation")
  console.print("never")
}
