// reject: E-TYP-040 (at the marked line)
// covers: LANG-06-08
// D-51.6: `||` does not narrow (LR 6.3, 6.8), and nesting it in `&&` does not help: the left conjunct
// narrows nothing about `p`, so inside the right conjunct's `||` the place is still `Limit?`.
export class Limit {
  export most: Int
  export pure func holds(self, n: Int) Bool => n <= self.most
}

export pure func inAnd(p: Limit?, n: Int, flag: Bool) Bool => flag && (p == null || p.holds(n))   // reject: E-TYP-040 — `||` did not narrow `p`
