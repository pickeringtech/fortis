// execute: 0 0|2 2|-10 -10|1.5 1.5|1 7.5 3
// requires: runtime
// covers: LANG-05-07
// D-60: `x op= e` is sugar for `x = x op e` (1.1), and operands are evaluated left to right (5.7), so `x` is read
// before `e` runs, and the store goes to the place `x` names after `e` has run. Each pair is the compound form and
// its expansion, where `e` changes `x` through an editable loan; the two must agree on every backend. The last line
// is the plain forms: a whole local of each kind and a field reached through an editable parameter.
import fortis.host { Console }

export class C {
  export n: Int<0..100>
}

export class O {
  export inner: C
}

export class S {
  export n: Int<-100..100>
  export f: Float
}

func bump(c: editable C) Int<1..9> {
  c.n = 7
  return 3
}

func swap(o: editable O) Int<1..9> {
  o.inner = C(n: 53)
  return 4
}

func shift(s: editable S) Int<1..9> {
  s.n = 90
  return 6
}

func halve(c: editable C) {
  c.n /= 2
}

func scale(s: editable S) Float {
  s.f = 10.0
  return 2.0
}

func main(console: Console) {
  let mut a = C(n: 0)
  a.n %= bump(editable a)
  let mut b = C(n: 0)
  b.n = b.n % bump(editable b)
  console.print("${a.n} ${b.n}")
  let mut o = O(inner: C(n: 6))
  o.inner.n %= swap(editable o)
  let mut p = O(inner: C(n: 6))
  p.inner.n = p.inner.n % swap(editable p)
  console.print("${o.inner.n} ${p.inner.n}")
  let mut s = S(n: -60, f: 3.0)
  s.n /= shift(editable s)
  let mut t = S(n: -60, f: 3.0)
  t.n = t.n / shift(editable t)
  console.print("${s.n} ${t.n}")
  s.f /= scale(editable s)
  t.f = t.f / scale(editable t)
  console.print("${s.f} ${t.f}")
  let mut k: Int<0..100> = 50
  k %= 7
  let mut g = 2.5
  g *= 3.0
  let mut h = C(n: 7)
  halve(editable h)
  console.print("${k} ${g} ${h.n}")
}
