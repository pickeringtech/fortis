// execute: local x|end
// requires: runtime
// covers: LANG-11-06
// D-397, 11.6: I/O through the capability field of a local the function made (`let d = make(console, "x")`,
// then `d.console.print(…)`), in a function that takes an Authority value (`Shared[Console]`): the local holds
// the retained authority as a parameter's value does, and the I/O is through an authority. Both checkers
// accept it and the interpreter always ran it; the VM's IR validation once refused it
// (`refused-ir:C1.capability`, the receiver not derived from a parameter through places alone), and the native
// build reported that refusal as E-INT-001, mislabelling a rule stricter than the Language Reference as an
// internal defect. The validator now derives a value a function call makes from a derived value through the
// call's arguments. Found by the v0.0.2-rc.9 wide review.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: label as String, console: console.retain())
}

func throughLocal(console: Shared[Console]) {
  let d = make(console, "x")
  d.console.print("local ${d.label}")
}

func main(console: Console) {
  let shared = Shared.create(move console)
  throughLocal(shared)
  shared.print("end")
}
