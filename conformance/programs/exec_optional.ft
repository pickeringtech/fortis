// execute: 7|present 3|absent
// requires: runtime
// covers: LANG-06-08
import fortis.host { Console }

pure func describe(v: Int?) String {
  return match v {
    present(x) => "present ${x}"
    null => "absent"
  }
}

func main(console: Console) {
  let maybe: Int? = null
  console.print("${maybe ?? 7}")
  console.print(describe(3))
  console.print(describe(null))
}
