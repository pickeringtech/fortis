// accept
// covers: LANG-07-05
export class Counter {
  export count: Int
  export func bump(editable self) {
    self.count = Int.wrappingAdd(self.count, 1)
  }
}
func run() Int {
  let mut c = Counter(count: 0)
  {
    let seen = alias c
    discard seen.count
  }
  c.bump()
  {
    let held = editable c
    held.count = 5
  }
  c.count = 6
  return c.count
}
