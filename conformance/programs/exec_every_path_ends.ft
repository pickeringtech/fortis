// execute: negative|zero|positive|caught demo.bad
// requires: runtime
// covers: LANG-05-05
// Every path of a non-Void function ends in `return` or `fail` (5.5).
import fortis.host { Console }

export error Bad {
  code: "demo.bad"
}

pure func sign(n: Int) String {
  if n < 0 {
    return "negative"
  } else if n == 0 {
    return "zero"
  }
  return "positive"
}

try func checked(n: Int) Int {
  if n > 10 {
    fail Bad()
  }
  return n
}

recovers func run(n: Int) String {
  let v = checked(n) catch e {
    recover -1
  }
  if v < 0 {
    return "caught demo.bad"
  }
  return "${v}"
}

recovers func main(console: Console) {
  console.print(sign(-5))
  console.print(sign(0))
  console.print(sign(9))
  console.print(run(11))
}
