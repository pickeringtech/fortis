// execute: made 1|made 2|arm 1|after|cleanup 1|cleanup 2
// requires: runtime
// covers: LANG-09-06
// 9.8: `match c` loans the enum. A field written `_` is not consumed, so both fields are destroyed when the local
// ends, after the next statement, and the match traces nothing.
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  export func make(id: Int, console: Shared[Console]) Handle {
    console.print("made ${id}")
    return Handle(id, console: console.retain())
  }
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

export enum Choice {
  Two(a: Handle, b: Handle)
  Empty
}

func run(console: Shared[Console]) {
  let c = Choice.Two(a: Handle.make(1, alias console), b: Handle.make(2, alias console))
  match c {
    Two(a: a, b: _) => { console.print("arm ${a.id}") }
    Empty => { console.print("empty") }
  }
  console.print("after")
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
}
