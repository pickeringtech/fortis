// execute: filling|defect:out_of_memory
// requires: runtime
// covers: LANG-12-04
// PROG-NFR-13: the detached-task queue has a declared bound (256); overflow is a visible defect, not silence.
import fortis.host { Supervisor, Console }
async func tick(n: Int) Int => n
async func flood(supervisor: Supervisor) {
  scope tasks {
    for i in 1..300 {
      let t = tasks.launch(tick(i))
      tasks.detach(move t, supervisor)
    }
  }
}
async func main(console: Console, supervisor: Supervisor) {
  console.print("filling")
  await flood(supervisor)
  console.print("never")
}
