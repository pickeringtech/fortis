// execute: 5|h|3
// requires: runtime
// covers: LANG-06-06
import fortis.host { Console }
import fortis.text { Scalar }

try func main(console: Console) {
  let word = "hello"
  console.print("${word.scalarCount()}")
  let first = word.scalarAt(0) or fail
  console.print("${first}")
  let piece = word.slice(2, 5) or fail
  console.print("${piece.scalarCount()}")
}
