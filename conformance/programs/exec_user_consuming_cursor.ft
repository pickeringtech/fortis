// execute: 2|1
// requires: runtime
// covers: LANG-10-02, LANG-06-16
import fortis.host { Console }
class Cursor[T] implements Consumer[T] where T: linear {
  items: List[T]
  export func next(editable self) T? => self.items.pop()
}
class Bag[T] implements Consumable[T, Cursor[T]] where T: linear {
  items: List[T]
  export func consume(owned self) Cursor[T] {
    let Bag(items: contents) = move self
    return Cursor(items: move contents)
  }
}
func main(console: Console) {
  let bag = Bag(items: List[Int].of(1, 2))
  for item in move bag {
    console.print("${item}")
  }
}
