// execute: NaN|false|false|false|true|true|true
// requires: runtime
// covers: LANG-06-05
import fortis.host { Console }

func main(console: Console) {
  let n = Float.sqrt(-1.0)
  console.print("${n}")
  console.print("${n == n}")
  console.print("${n < 1.0}")
  console.print("${n > 1.0}")
  console.print("${n != n}")
  console.print("${Float.isNaN(n)}")
  console.print("${Float.bitsEqual(n, n)}")
}
