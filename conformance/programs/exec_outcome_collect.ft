// execute: 2|demo.odd
// requires: runtime
// covers: LANG-10-02
import fortis.host { Console }

export error Odd {
  code: "demo.odd"
}

try func half(n: Int) Int {
  let r = Int.rem(n, 2) or fail
  if r == 1 {
    fail Odd()
  }
  return Int.div(n, 2) or fail
}

try recovers func main(console: Console) {
  let mut good: List[Outcome[Int]] = List.default()
  good.push(half(2))
  good.push(half(4))
  let values = Outcome.collect(move good) or fail
  console.print("${values.count()}")
  let mut mixed: List[Outcome[Int]] = List.default()
  mixed.push(half(2))
  mixed.push(half(3))
  let none = Outcome.collect(move mixed) catch e {
    console.print(e.code)
    recover List.default()
  }
  discard none
}
