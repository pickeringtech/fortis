// reject: E-TYP-090 (at the marked line)
// covers: LANG-06-10
// A Secret never serialises: deriving Encodable over a Secret field is rejected (6.10, 15).
import fortis.host { Secret }
export class Credentials derive Encodable {      // reject: E-TYP-090 — Secret[String] is not Encodable
  export user: String
  export password: Secret[String]
}
