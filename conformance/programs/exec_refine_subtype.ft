// execute: 42|142|refinement.out_of_range
// requires: runtime
// covers: LANG-06-02
import fortis.host { Console }

pure func wide(value: Int<0..200>) Int => value

try recovers func main(console: Console) {
  let small = Int<0..50>.validate(42) or fail
  console.print("${wide(small)}")
  let big = Int<0..200>.validate(142) or fail
  console.print("${wide(big)}")
  let bad = Int<0..50>.validate(142) catch e {
    console.print(e.code)
    recover 0
  }
  discard bad
}
