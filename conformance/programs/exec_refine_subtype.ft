// execute: 42|142|refinement.out_of_range
// requires: runtime
// covers: LANG-06-02
import fortis.host { Console }

pure func wide(value: Int<0..200>) Int => value

try recovers func main(console: Console) {
  let small = 42
  console.print("${wide(small)}")
  let big = 142
  console.print("${wide(big)}")
  let bad = 142 as Int<0..50> catch e {
    console.print(e.code)
    recover 0
  }
  discard bad
}
