// execute: 3|[alpha, beta, gamma]|7|null|10|empty true|ell
// requires: runtime
// covers: LANG-03-05
// fortis.text intrinsics: graphemes counts clusters (e + combining acute is one), words splits on white space.
import fortis.host { Console }
import fortis.text { graphemes, Text, Scalar }
recovers func main(console: Console) {
  console.print("${graphemes("aéz")}")
  console.print("${Text.words("  alpha beta\tgamma ")}")
  console.print("${Scalar.digitValue(Scalar.of("7")) ?? 0}")
  console.print("${Scalar.digitValue(Scalar.of("x"))}")
  console.print("${Scalar.hexValue(Scalar.of("a")) ?? 0}")
  let e = String.empty()
  console.print("empty ${e.scalarCount() == 0}")
  let word = "hello"
  let middle = word.slice(1, 4) or recover "?"
  console.print("${middle}")
}
