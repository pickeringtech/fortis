// execute: 4 bytes|70|3 bytes|10|0 bytes
// requires: runtime
// covers: LANG-03-05
// A byte string literal `b"…"` is a `BytesView` of static ASCII bytes (3.5); an escape stands for one byte
// (`\n` is 10). The interpreter once could not evaluate the literal at all (D-53).
import fortis.host { Host }

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let magic = b"FTS1"
  caps.console.print("${magic.byteCount()} bytes")
  caps.console.print("${magic.get(0) ?? 0}")
  let line = b"a\nb"
  caps.console.print("${line.byteCount()} bytes")
  caps.console.print("${line.get(1) ?? 0}")
  let empty = b""
  caps.console.print("${empty.byteCount()} bytes")
}
