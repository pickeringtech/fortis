// execute: 2|0
// requires: runtime
// covers: LANG-10-05
import fortis.host { Console }

export error Odd {
  code: "demo.odd"
}

try func half(n: Int) Int {
  let r = Int.rem(n, 2) or fail
  if r == 1 {
    fail Odd()
  }
  return Int.div(n, 2) or fail
}

recovers func safeHalf(n: Int) Int => half(n) or recover 0

recovers func main(console: Console) {
  console.print("${safeHalf(4)}")
  console.print("${safeHalf(3)}")
}
