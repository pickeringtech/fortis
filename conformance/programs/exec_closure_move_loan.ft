// execute: captured a|drop side|list a|end|drop a
// requires: runtime
// covers: LANG-07-07, LANG-07-05
// D-374, 7.9, 8.3: a closure that captures a binding holding a loan by `move t` holds that loan: its body moving the
// capture into a tuple moves the loan, so the tuple destroys nothing it borrows, and the list still owns its
// element. The VM gave the tuple the element as its own and ran its cleanup inside the closure. A capture of a
// binding that owns its value (a `??` whose fallback it owns) still owns it, and the tuple destroys it in index
// order on every backend (exec_closure_move_owned.ft; D-378).
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]
  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: label as String, console: console.retain())
}

func lentCapture(console: Shared[Console], xs: List[Token]) {
  let t = xs.get(0)
  {
    let f = fn once[move t, alias console]() Void {
      let p = (move t, make(console, "side"))
      console.print("captured ${p.0?.label ?? "none"}")
    }
    move f()
  }
  console.print("list ${xs.get(0)?.label ?? "none"}")
}

func main(out: Console) {
  let console = Shared.create(move out)
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "a"))
  lentCapture(console, xs)
  console.print("end")
}
