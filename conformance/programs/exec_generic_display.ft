// execute: hello
// requires: runtime
// covers: LANG-03-05
// A generic class with its own `display` shows that text (LR 11.1). The method's bounds stay on the
// display, and interpolation uses them.
import fortis.host { Console }
import fortis.text { Builder }

export class Hold[T] implements Displayable {
  export value: T
  export pure func display(self, into: editable Builder) {
    into.append("hello")
  }
}

func main(console: Console) {
  let h = Hold(value: 1)
  console.print("${h}")
}
