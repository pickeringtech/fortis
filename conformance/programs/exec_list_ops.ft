// execute: 3|30|20|2|first 10|empty false
// requires: runtime
// covers: LANG-06-07
import fortis.host { Console }

func main(console: Console) {
  let mut xs: List[Int] = List.default()
  xs.push(10)
  xs.push(20)
  xs.push(30)
  console.print("${xs.count()}")
  console.print("${editable xs.pop() ?? 0}")
  console.print("${xs.get(1) ?? 0}")
  console.print("${xs.count()}")
  console.print("first ${xs.first() ?? 0}")
  console.print("empty ${xs.isEmpty()}")
}
