// reject: E-TYP-040 (at the marked line)
// covers: LANG-06-08
// A field of type `T?` is not narrowed by being named (LR 6.8).
export class Cell {
  export n: Int
  export pure func read(self) Bool => self.n == 0
}

export class Holder {
  export p: Cell?
}

export pure func bare(d: Holder) Bool => d.p.read() // reject: E-TYP-040 — `d.p` is still Cell?
