// execute: fail:money.currency_mismatch
// requires: runtime
// covers: LANG-06-04
// Arithmetic between currencies fails with the documented failure (15).
import fortis.host { Host }
import fortis.money { Money, Currency, CurrencyMismatch }
export try func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let total = Money.add(Money.of(Currency.GBP, 1d), Money.of(Currency.USD, 1d)) or fail
  caps.console.print("${total.amount}")
}
