// execute: fail:money.currency_mismatch
// requires: runtime
// covers: LANG-06-04
// Arithmetic between currencies fails with the documented failure (15).
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
try func main(console: Console) {
  let total = Money.add(Money.of(GBP, 1d), Money.of(USD, 1d)) or fail
  console.print("${total.amount}")
}
