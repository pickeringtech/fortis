// accept
// covers: LANG-07-06
export class User {
  export name: String
}
pure func displayName(user: User) StringView from user {
  return alias user.name
}
func run(user: User) Int {
  let name = displayName(alias user)
  let again = displayName(alias user)
  return Int.saturatingAdd(name.scalarCount(), again.scalarCount())
}
