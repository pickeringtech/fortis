// execute: true|false|false|false|false|false
// requires: runtime
// covers: LANG-06-04
// Money.greaterThan is a total order within one currency; amounts in different currencies are incomparable.
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
func main(console: Console) {
  let ten = Money.of(GBP, 10d)
  let five = Money.of(GBP, 5.00d)
  console.print("${Money.greaterThan(ten, five)}")
  console.print("${Money.greaterThan(five, ten)}")
  console.print("${Money.greaterThan(ten, Money.of(GBP, 10.00d))}")
  console.print("${Money.greaterThan(Money.of(GBP, 10.00d), ten)}")
  console.print("${Money.greaterThan(ten, Money.of(USD, 1d))}")
  console.print("${Money.greaterThan(Money.of(USD, 1d), ten)}")
}
