// reject: E-TYP-120 (at the marked lines)
// covers: LANG-14-04
// `expect` is test code: it is allowed only in `test` and `property` bodies (and the `cases` bodies inside them), and is
// a compile error anywhere else (14; D-414; the owner's decision of 29 October): a function body, a deferred block, a
// lambda outside a test, a method.
import fortis.host { Console }

export class Counter {
  export n: Int
  func check(self) Int {
    expect self.n > 0                          // reject: E-TYP-120
    return self.n
  }
}

func inBody(n: Int) Int {
  expect n > 0                                 // reject: E-TYP-120
  return 1
}

func inDefer(console: Shared[Console], n: Int) Int {
  defer {
    expect n > 0                               // reject: E-TYP-120
    console.print("never")
  }
  return 1
}

func inLambda(n: Int) Int {
  let f = fn[n]() Int {
    expect n > 0                               // reject: E-TYP-120
    return n
  }
  return f()
}

func main(console: Console) {
  let shared = Shared.create(move console)
  shared.print("got ${inBody(0)}")
  shared.print("got ${inDefer(shared, 0)}")
  shared.print("got ${inLambda(0)}")
  shared.print("got ${Counter(n: 0).check()}")
}
