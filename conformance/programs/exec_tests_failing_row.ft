// execute: 2 passed, 1 failed
// tests: run
// reports: test-result:pass|test-result:fail|test-result:pass
// requires: runtime
// covers: LANG-14-02
// A false `expect` fails only its row; the record names the row and carries the actual/expected pair.
pure func double(n: Int) Int => Int.wrappingAdd(n, n)
test "doubling" cases {
  "zero": { n: 0, expected: 0 }
  "one": { n: 1, expected: 3 }
  "two": { n: 2, expected: 4 }
} as row {
  expect double(row.n) == row.expected
}
