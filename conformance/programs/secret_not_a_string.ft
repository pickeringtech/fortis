// reject: E-TYP-040 (at the marked line)
// covers: LANG-11-07
// Environment.get hands out a Secret, never the plain value: using it as text is refused (15).
import fortis.host { Environment, Console }
func show(env: Environment, console: Console) Void {
  match env.get("PATH") {
    present(s) => console.print(s)               // reject: E-TYP-040 — Secret[String] is not a StringView
    null => console.print("unset")
  }
}
