// execute: 127.0.0.1
// requires: runtime
// covers: LANG-11-07
import fortis.host { Host, Network }
try func lookup(net: Network) String => net.resolve("localhost") or fail
export try func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print(lookup(caps.network) or fail)
}
