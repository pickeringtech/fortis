// execute: total 23|counted 2
// requires: runtime
// covers: LANG-07-09, LANG-11-03
// SP-02-async, supplementary to the preregistered workload: with `noalloc` callback types, a `noalloc` async callee
// awaits an async callback twice and calls a `fn mut` callback between; the call adds no allocation (11.3).
import fortis.host { Host }
noalloc async func twice(step: noalloc async fn(Int) Int, note: editable noalloc fn mut() Void) Int {
  let a = await step(1)
  editable note()
  let b = await step(2)
  editable note()
  return Int.wrappingAdd(a, b)
}
export async func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let mut count = 0
  let mut total = 0
  let base = 10
  {
    let mut note = noalloc fn mut[editable count]() Void {
      count = Int.wrappingAdd(count, 1)
    }
    total = await twice(noalloc async fn[base](n: Int) Int {
      return Int.wrappingAdd(n, base)
    }, editable note)
  }
  caps.console.print("total ${total}")
  caps.console.print("counted ${count}")
}
