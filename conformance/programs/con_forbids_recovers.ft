// reject: E-EFF-001 (at the marked line)
// covers: LANG-11-06
// A contract subtracts: `forbids recovers` rejects a body with that effect, naming the contract (11.5).
contract Strict {
  forbids recovers
}
try func half(n: Int) Int => n
Strict recovers func quiet(n: Int) Int => half(n) or recover 0   // reject: E-EFF-001 — Strict forbids recovers
