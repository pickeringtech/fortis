// execute: 1 1 5 5
// requires: runtime
// covers: LANG-07-06, LANG-08-02
import fortis.host { Console }
class Holder[F] { export work: F }
func moved() List[fn() Int] {
  let s = "hello" as String
  let f = fn[move s]() Int => s.byteCount()
  return List.of(move f)
}
func copied() List[fn() Int] {
  let s = "hello" as String
  let f = fn[copy s]() Int => s.byteCount()
  return List.of(move f)
}
func field() Holder[fn() Int] {
  let s = "hello" as String
  return Holder(work: fn[move s]() Int => s.byteCount())
}
func returned() fn() Int {
  let s = "hello" as String
  return fn[copy s]() Int => s.byteCount()
}
func main(console: Console) {
  let a = moved()
  let b = copied()
  let h = field()
  let f = returned()
  console.print("${a.count()} ${b.count()} ${(h.work)()} ${f()}")
}
