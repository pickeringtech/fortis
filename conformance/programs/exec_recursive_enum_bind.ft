// execute: built 1
// requires: runtime
// covers: LANG-09-05
// Constructing a recursive enum and binding its payload by name builds with the fields boxed. A wildcard does
// not look inside the box, so this neighbour stays valid on either side of the nested-pattern fix.
import fortis.host { Console }

export enum Tree {
  Leaf
  Node(left: Tree, right: Tree)
}

pure func tag(t: Tree) Int {
  return match t {
    Leaf => 0
    Node(left: l, right: _) => match l {
      Leaf => 1
      Node(left: _, right: _) => 2
    }
  }
}

func main(console: Console) {
  let t = Tree.Node(left: Leaf, right: Leaf)
  console.print("built ${tag(t)}")
}
