// execute: a|b|2
// requires: runtime
// covers: LANG-07-04
import fortis.host { Console }

export class Box {
  export label: String
}

func main(console: Console) {
  let mut box = Box(label: "a")
  let taken = move box
  console.print(taken.label)
  box = Box(label: "b")
  console.print(box.label)
  let mut count = 0
  count = count + 1
  count = count + 1
  console.print("${count}")
}
