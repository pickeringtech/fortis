// execute: 6|3|fallback|ok|11
// requires: runtime
// covers: LANG-03-02
// A statement continues onto the next line after a trailing operator, comma or opening bracket, or before a leading
// continuation token (`.`, `or`, `??`, `)`, `]`); otherwise a newline ends it (3.2).
import fortis.host { Console }

export error Missing {
  code: "demo.missing"
}

try func find(n: Int) Int {
  if n < 0 {
    fail Missing()
  }
  return n
}

recovers func lookup(n: Int) Int {
  let v = find(n)
    or recover 3
  return v
}

recovers func main(console: Console) {
  let total = Int.wrappingAdd(
    1,
    5
  )
  console.print("${total}")
  console.print("${lookup(-1)}")
  let name: String? = null
  console.print(name
    ?? "fallback")
  let words = List.of("ok", "no")
  console.print(words
    .get(0) ?? "")
  let sum = 1 +
    10
  console.print("${sum}")
}
