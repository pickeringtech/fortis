// execute: drop moved|end
// execute-trace: drop Token
// requires: runtime
// covers: LANG-07-07, LANG-05-07
// D-454, LR 7.9: a discarded recovery moves the fallback into its statement temporary.
// The moved binding owns nothing afterwards, so the replacement is destroyed once.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: label as String, console: console.retain())
}

export error Missing {
  code: "demo.missing"
}

try func find(xs: List[Token]) alias Token from xs {
  match xs.get(0) {
    present(t) => { return t }
    null => { fail Missing() }
  }
}

recovers func main(out: Console) {
  let console = Shared.create(move out)
  let xs: List[Token] = List.default()
  let replacement = make(console, "moved")
  discard find(alias xs) or recover move replacement
  console.print("end")
}
