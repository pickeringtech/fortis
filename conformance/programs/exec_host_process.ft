// execute: 0|1
// requires: runtime
// covers: LANG-11-07
// The development Process adapter starts no process: it simulates `true` and `false`.
import fortis.host { Process, Console }
try func status(p: Process, program: StringView) Int => p.run(program, List.default()) or fail
try func main(process: Process, console: Console) {
  let ok = status(process, "true") or fail
  let bad = status(process, "false") or fail
  console.print("${ok}")
  console.print("${bad}")
}
