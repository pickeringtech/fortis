// execute: 7|7|present 7
// requires: runtime
// covers: LANG-07-08
import fortis.host { Console }

export class Config {
  export limit: Int
}

func main(console: Console) {
  let shared = Shared.create(Config(limit: 7))
  let other = shared.retain()
  console.print("${shared.limit}")
  console.print("${other.limit}")
  let weak = shared.downgrade()
  match weak.upgrade() {
    present(strong) => console.print("present ${strong.limit}")
    null => console.print("gone")
  }
}
