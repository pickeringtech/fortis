// execute: matched|typed|viewed
// requires: runtime
// covers: LANG-03-04
// A keyword may name a method or associated function, and is admitted after `.` (memberName), though not as a
// binding (3.4).
import fortis.host { Console }

export class Probe {
  export label: String
  export pure func match(self) String => "matched"
  export pure func type(self) String => "typed"
  export pure func view(self) String => "viewed"
}

func main(console: Console) {
  let p = Probe(label: "p")
  console.print(p.match())
  console.print(p.type())
  console.print(p.view())
}
