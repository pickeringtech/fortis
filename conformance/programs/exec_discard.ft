// execute: kept 3|discarded
// requires: runtime
// covers: LANG-05-08
// A non-Void value that is not used must be discarded explicitly; `discard` evaluates and drops it (5.8).
import fortis.host { Console }

pure func three() Int => 3

func main(console: Console) {
  let kept = three()
  console.print("kept ${kept}")
  discard three()
  console.print("discarded")
}
