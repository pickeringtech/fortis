// reject: E-OWN-053, E-OWN-002
// covers: LANG-06-14, LANG-07-06
// D-580: H's local view newtype keeps its loan across storage inference.
type Borrowed = ListView[Int]
type Short = ListView[Int]<length: 1..3>
func written(xs: List[Borrowed], ys: List[Short?]) {} // reject: E-OWN-053
func inferred(xs: ListView[Int]) {
  let borrowed = Borrowed(xs)
  // Moving the local loan cannot supply an owned element either (7.6).
  let stored = List.of(move borrowed) // reject: E-OWN-053, E-OWN-002
}
