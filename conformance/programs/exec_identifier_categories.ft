// execute: Point|3|4|lower and Upper
// requires: runtime
// covers: LANG-03-03
// The first character decides an identifier's category: lowercase names values and functions, uppercase names
// types and variants, without a symbol table (3.3).
import fortis.host { Console }

export class Point {
  export x: Int
  export y: Int
}

func main(console: Console) {
  let point = Point(x: 3, y: 4)
  console.print("Point")
  console.print("${point.x}")
  console.print("${point.y}")
  console.print("lower and Upper")
}
