// execute: 42|refinement.out_of_range
// requires: runtime
// covers: LANG-06-03
import fortis.host { Console }

export type Percent = Int<0..100>

try recovers func main(console: Console) {
  let fine = Int<0..100>.validate(42) or fail
  console.print("${fine}")
  let bad = Int<0..100>.validate(300) catch e {
    console.print(e.code)
    recover 0
  }
  discard bad
}
