// execute: 3
// requires: runtime
// covers: LANG-08-04
import fortis.host { Console }
class Holder[F] { work: F }
try func parse(s: String) Int => s as Int or fail
try func main(console: Console) {
  let holder = Holder[try fn(String) Int](work: move parse)
  let f = alias holder.work
  let n = f("3") or fail
  console.print("${n}")
}
