// execute: false|true|0.30000000000000004|0.3|2.0|true|-0.0
// requires: runtime
// covers: LANG-06-05
import fortis.host { Host }

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print("${0.1 + 0.2 == 0.3}")
  caps.console.print("${1.5 + 1.5 == 3.0}")
  caps.console.print("${0.1 + 0.2}")
  caps.console.print("${0.1f32 + 0.2f32}")
  caps.console.print("${Float.sqrt(4.0)}")
  caps.console.print("${0.0 == -0.0}")
  caps.console.print("${-0.0}")
}
