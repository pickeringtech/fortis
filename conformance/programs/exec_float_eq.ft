// execute: false|true|0.30000000000000004|0.3|2.0|true|-0.0
// requires: runtime
// covers: LANG-06-05
import fortis.host { Console }

func main(console: Console) {
  console.print("${0.1 + 0.2 == 0.3}")
  console.print("${1.5 + 1.5 == 3.0}")
  console.print("${0.1 + 0.2}")
  console.print("${0.1f32 + 0.2f32}")
  console.print("${Float.sqrt(4.0)}")
  console.print("${0.0 == -0.0}")
  console.print("${-0.0}")
}
