// accept
// covers: LANG-07-04
// The `for` binding is fresh on every iteration, so moving it once per iteration is accepted.
func take(s: owned String) Int => s.byteCount()
func main() {
  let items = List.of("a" as String, "bc" as String)
  let mut total = 0
  for s in move items {
    total = Int.saturatingAdd(total, take(move s))
  }
}
