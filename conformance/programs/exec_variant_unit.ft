// execute: penny|penny
// requires: runtime
// covers: LANG-09-07
// A payload-free variant used as `fn() Coin` is that constructor (LR 9.7). Calling it yields the variant.
// Where the expected type is the enum, the same name is still the variant value.
import fortis.host { Console }

enum Coin {
  Penny
}

pure func label(c: Coin) String {
  return match c {
    Penny => "penny"
  }
}

func main(console: Console) {
  let f: fn() Coin = Coin.Penny
  console.print(label(f()))
  let penny: Coin = Penny
  console.print(label(penny))
}
