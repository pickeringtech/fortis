// accept
// covers: LANG-12-05
// 12.7: shareable values cross a pool launch by copy or move; the cooperative launch may still borrow.
export class Buffer {
  export used: Int
}
async func scan(b: owned Buffer) Int => b.used
async func peek(b: Buffer) Int => b.used
async func run() Int {
  let buf = Buffer(used: 1)
  let items = List.of(1, 2, 3)
  scope tasks {
    let a = tasks.launchParallel(scan(copy buf))
    let b = tasks.launchBlocking(fn once[move items]() Int => items.count())
    let c = tasks.launch(peek(buf))
    return Int.wrappingAdd(Int.wrappingAdd(await a, await b), await c)
  }
}
