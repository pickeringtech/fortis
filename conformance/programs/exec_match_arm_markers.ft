// execute: ada|ada|size 3|z|1|20|x|x|x|x
// requires: runtime
// covers: LANG-07-01, LANG-08-02
// The marked positions of own_match_arm_marker.ft with their markers, and the state closure of
// fun_copy_capture_assigned.ft captured with `move` (D-159, D-155): one output on every backend.
import fortis.host { Console }

export class User {
  export name: String
  export age: Int
}

export enum Slot {
  Empty
  Full(label: String)
  Size(count: Int)
}

func pickName(user: User, flag: Bool) String {
  return match flag {
    true => copy user.name
    false => String.from("anonymous")
  }
}

func nameOf(opt: User?) String {
  return match opt {
    present(u) => copy u.name
    null => String.from("anonymous")
  }
}

func takeLabel(slot: owned Slot) String {
  return match move slot {
    Full(label: l) => move l
    Size(count: c) => "size ${c}"
    Empty => String.from("none")
  }
}

func either(b: Bool) String {
  let x = String.from("x")
  return match b {
    true => move x
    false => move x
  }
}

func eitherBlock(b: Bool) String {
  let x = String.from("x")
  return match b {
    true => {
      give move x
    }
    false => {
      give move x
    }
  }
}

func main(console: Console) {
  let u = User(name: String.from("ada"), age: 36)
  console.print(pickName(u, true))
  console.print(nameOf(present(u)))
  console.print(takeLabel(Size(count: 3)))
  console.print(takeLabel(Full(label: String.from("z"))))
  let mut total = 0
  let mut bump = pure noalloc fn mut[move total]() Int {
    total = Int.saturatingAdd(total, 1)
    return total
  }
  console.print("${editable bump()}")
  let base = 10
  let twice = pure noalloc fn[copy base]() Int {
    return Int.saturatingAdd(base, base)
  }
  console.print("${twice()}")
  console.print(either(true))
  console.print(either(false))
  console.print(eitherBlock(true))
  console.print(eitherBlock(false))
}
