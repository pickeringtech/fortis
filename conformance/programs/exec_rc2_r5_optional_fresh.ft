// execute: 0 1 0 2 0 3 0 4
// requires: runtime
// covers: LANG-06-09, LANG-10-01
import fortis.host { Console }
class Cell { export func take(self, n: Int) Int => n }
func consume(m: owned Must) Int { Must.discharge(move m)
  return 4 }
try func main(console: Console) {
  let none: Cell? = null
  let some: Cell? = Cell()
  let a = none?.take("1" as Int or fail) ?? 0
  let b = some?.take("1" as Int or fail) ?? 0
  let c = none?.take(match 0 { _ => { let out = "2" as Int
    give out or fail } }) ?? 0
  let d = some?.take(match 0 { _ => { let out = "2" as Int
    give out or fail } }) ?? 0
  let e = none?.take(match 0 { _ => { let m = Must.create()
    Must.discharge(move m)
    give 3 } }) ?? 0
  let f = some?.take(match 0 { _ => { let m = Must.create()
    Must.discharge(move m)
    give 3 } }) ?? 0
  let g = none?.take(consume(Must.create())) ?? 0
  let h = some?.take(consume(Must.create())) ?? 0
  console.print("${a} ${b} ${c} ${d} ${e} ${f} ${g} ${h}")
}
