// execute: left|right|args 1 2|receiver|argument
// requires: runtime
// covers: LANG-05-07
// Evaluation is left to right: operands, arguments, then the receiver before its arguments (5.7), identically on
// every backend.
import fortis.host { Host, Console }

func note(console: Console, what: String, n: Int) Int {
  console.print(what)
  return n
}

export class Recorder {
  export count: Int
  export func add(self, console: Console, n: Int) Int {
    console.print("argument")
    return Int.wrappingAdd(self.count, n)
  }
}

func make(console: Console) Recorder {
  console.print("receiver")
  return Recorder(count: 0)
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let sum = Int.wrappingAdd(note(caps.console, "left", 1), note(caps.console, "right", 2))
  caps.console.print("args 1 ${Int.wrappingSub(sum, 1)}")
  discard make(caps.console).add(caps.console, 1)
}
