// execute: bye 5|got 5|bye 7|got 7|end
// execute-trace: loans-end|defer|loans-end|defer
// requires: runtime
// covers: LANG-12-01, LANG-06-11, LANG-07-05, LANG-03-06
// D-415: a record whose fields are all trivial is trivial (6.11) and is copied by `return r` (7.5), so a
// deferred block that reads the local after the return still sees it, whether the record holds integers or a
// trivial class beside them. Natively the lowering derived `Clone` but not `Copy` for a record type and judged
// it non-trivial, so the return moved the record past the deferred block's borrow (rustc E0382, reported as
// E-INT-002) where both checkers accept the program; a record of trivial fields now derives `Copy` and is
// trivial to the lowering as to the checkers, and the output and the trace are the same on every backend.
import fortis.host { Console }

trivial class Point {
  export x: Int
  export y: Int
}

func ints(console: Shared[Console]) { n: Int, m: Int } {
  let r = { n: 5, m: 8 }
  defer {
    console.print("bye ${r.n}")
  }
  return r
}

func points(console: Shared[Console]) { p: Point, n: Int } {
  let r = { p: Point(x: 7, y: 6), n: 8 }
  defer {
    console.print("bye ${r.p.x}")
  }
  return r
}

func main(console: Console) {
  let shared = Shared.create(move console)
  let a = ints(shared)
  shared.print("got ${a.n}")
  let b = points(shared)
  shared.print("got ${b.p.x}")
  shared.print("end")
}
