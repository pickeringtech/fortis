// execute: 6|5
// requires: runtime
// covers: LANG-07-02
import fortis.host { Console }

pure func bumped(start: Int) Int {
  let mut current = start
  current = Int.wrappingAdd(current, 1)
  return current
}

func main(console: Console) {
  let start = 5
  console.print("${bumped(start)}")
  console.print("${start}")
}
