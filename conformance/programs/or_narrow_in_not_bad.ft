// reject: E-TYP-040 (at the marked line)
// covers: LANG-06-08
// D-51.6: `||` does not narrow (LR 6.3, 6.8), and nesting it under `!` does not help: the method call
// inside the operand runs with `p` still `Limit?`.
export class Limit {
  export most: Int
  export pure func holds(self, n: Int) Bool => n <= self.most
}

export pure func inNot(p: Limit?, n: Int) Bool => !(p == null || p.holds(n))   // reject: E-TYP-040 — `||` did not narrow `p`
