// execute: true|true|false|true|true
// requires: runtime
// covers: LANG-06-04
// 15: comparison operators on Duration compare the nanosecond counts.
import fortis.host { Console }
func main(console: Console) {
  let minute = Duration.seconds(60)
  console.print("${minute == Duration.minutes(1)}")
  console.print("${Duration.milliseconds(999) < Duration.seconds(1)}")
  console.print("${Duration.hours(1) < Duration.minutes(59)}")
  console.print("${Duration.days(1) >= Duration.hours(24)}")
  console.print("${minute.nanoseconds() == 60000000000}")
}
