// reject: E-REF-002 (at the marked line)
// covers: LANG-03-06, LANG-06-02
// D-161: a hole is the lexer's `${…}`, which skips a string nested in it, so `"}"` inside a hole does not end it. The
// hole is typed (3.6), and its `editable c` loan invalidates `c.v`'s facts before the division.
export class Cell {
  export v: Int<0..1>
}

func reset(c: editable Cell, s: StringView) Int {
  c.v = 0
  return 0
}

export func f(c: editable Cell) Int {
  if c.v == 1 {
    let s = "${reset(editable c, "}")}"
    return 1 / c.v                           // reject: E-REF-002 — the hole set `c.v` to 0
  }
  return 0
}
