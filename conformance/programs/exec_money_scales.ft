// execute: 0.35|2.010|0.300
// requires: runtime
// covers: LANG-06-04
// Mixed scales within one currency: add uses the larger scale, multiply keeps the amount's scale.
import fortis.host { Host }
import fortis.money { Money, Currency, CurrencyMismatch }
export try func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let a = Money.add(Money.of(Currency.EUR, 0.1d), Money.of(Currency.EUR, 0.25d)) or fail
  caps.console.print("${a.amount}")
  let b = Money.multiply(Money.of(Currency.EUR, 1.005d), 2) or fail
  caps.console.print("${b.amount}")
  let c = Money.add(Money.of(Currency.EUR, 0.1d), Money.of(Currency.EUR, 0.200d)) or fail
  caps.console.print("${c.amount}")
}
