// execute: 0.35|2.010|0.300
// requires: runtime
// covers: LANG-06-04
// Mixed scales within one currency: add uses the larger scale, multiply keeps the amount's scale.
import fortis.host { Console }
import fortis.money { Money, Currency, CurrencyMismatch }
try func main(console: Console) {
  let a = Money.add(Money.of(EUR, 0.1d), Money.of(EUR, 0.25d)) or fail
  console.print("${a.amount}")
  let b = Money.multiply(Money.of(EUR, 1.005d), 2) or fail
  console.print("${b.amount}")
  let c = Money.add(Money.of(EUR, 0.1d), Money.of(EUR, 0.200d)) or fail
  console.print("${c.amount}")
}
