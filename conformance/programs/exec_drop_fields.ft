// execute: cleanup pair|cleanup 1|cleanup 2|done
// requires: runtime, DEL-21
// covers: LANG-07-07
// 7.9: a class value runs its own cleanup, then its fields drop in declaration order. Each value holds the console
// through a Shared handle (no field stores a loan, X-137).
import fortis.host { Console }

export class Handle {
  export id: Int
  export console: Shared[Console]
  cleanup(editable self) {
    self.console.print("cleanup ${self.id}")
  }
}

export class Pair {
  export first: Handle
  export second: Handle
  export console: Shared[Console]
  cleanup(editable self) {
    self.console.print("cleanup pair")
  }
}

func run(console: Shared[Console]) {
  let p = Pair(first: Handle(id: 1, console: console.retain()), second: Handle(id: 2, console: console.retain()), console: console.retain())
}

func main(out: Console) {
  let console = Shared.create(move out)
  run(console)
  console.print("done")
}
