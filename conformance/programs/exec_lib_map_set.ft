// execute: 2|10|absent|3|true|false|2|true
// requires: runtime
// covers: LANG-06-06
// 6.7: Map and Set are hash containers; replacing a value keeps the key's place; Set.add reports novelty.
import fortis.host { Console }
func main(console: Console) {
  let mut stock: Map[String, Int] = Map.default()
  stock.set("apple", 3)
  stock.set("pear", 5)
  console.print("${stock.count()}")
  stock.set("apple", 10)
  console.print("${stock.get("apple") ?? 0}")
  let missing = match stock.get("plum") {
    present(v) => "present"
    null => "absent"
  }
  console.print(missing)
  let mut seen: Set[Int] = Set.default()
  discard seen.add(1)
  discard seen.add(2)
  discard seen.add(3)
  console.print("${seen.count()}")
  console.print("${seen.contains(2)}")
  console.print("${editable seen.add(2)}")
  let mut pairs: Set[String] = Set.default()
  discard pairs.add("a")
  discard pairs.add("b")
  console.print("${pairs.count()}")
  console.print("${pairs.contains("b")}")
}
