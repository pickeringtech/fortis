// reject: E-TYP-040 (at the marked line)
// covers: LANG-06-08
// `||` does not narrow a field, just as it does not narrow a local (LR 6.3, 6.8).
export class Cell {
  export n: Int
  export pure func read(self) Bool => self.n == 0
}

export class Holder {
  export p: Cell?
}

export pure func viaOr(d: Holder) Bool => d.p != null || d.p.read() // reject: E-TYP-040 — `||` did not narrow `d.p`
