// execute: small|large|equal
// requires: runtime
// covers: LANG-05-03
import fortis.host { Host }

pure func size(n: Int) String {
  if n < 10 {
    return "small"
  } else if n > 10 {
    return "large"
  } else {
    return "equal"
  }
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print(size(3))
  caps.console.print(size(30))
  caps.console.print(size(10))
}
