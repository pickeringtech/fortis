// execute: small|large|equal
// requires: runtime
// covers: LANG-05-03
import fortis.host { Console }

pure func size(n: Int) String {
  if n < 10 {
    return "small"
  } else if n > 10 {
    return "large"
  } else {
    return "equal"
  }
}

func main(console: Console) {
  console.print(size(3))
  console.print(size(30))
  console.print(size(10))
}
