// execute: fs.outside_root|fs.outside_root|fs.closed|network.unreachable|clock.future|process.denied|sql.unavailable|path.invalid
// requires: runtime
// covers: LANG-11-07
// Each development adapter refuses its contract's violation with an outcome (DEL-28 adapter contracts).
import fortis.host { FileSystem, Network, Clock, Process, RawSql, Path, Console }
try func escape(fs: FileSystem) String {
  let p = Path.parse("../outside.txt") or fail
  return fs.readText(p) or fail
}
try func confined(fs: FileSystem) String {
  let up = Path.parse("../elsewhere") or fail
  let inner = fs.subtree(up)
  let p = Path.parse("a.txt") or fail
  return inner.readText(p) or fail
}
try func afterClose(fs: FileSystem) Int {
  let p = Path.parse("w.txt") or fail
  let mut f = fs.create(p) or fail
  let data = fs.readAll(p) or fail
  f.close()
  f.writeAll(data) or fail
  return 0
}
try func future(clock: Clock) Duration {
  let later = Timestamp.add(Timestamp.epoch(), Duration.seconds(10)) or fail
  return clock.frozen(Timestamp.epoch()).elapsedSince(later) or fail
}
try func parsed(text: String) Int {
  let p = Path.parse(text) or fail
  return 1
}
recovers func main(fileSystem: FileSystem, console: Console, network: Network, clock: Clock, process: Process, rawSql: RawSql) {
  discard escape(fileSystem) catch e {
    console.print(e.code)
    recover ""
  }
  discard confined(fileSystem) catch e {
    console.print(e.code)
    recover ""
  }
  discard afterClose(fileSystem) catch e {
    console.print(e.code)
    recover 0
  }
  discard network.resolve("example.com") catch e {
    console.print(e.code)
    recover ""
  }
  discard future(clock) catch e {
    console.print(e.code)
    recover Duration.seconds(0)
  }
  discard process.run("rm", List.default()) catch e {
    console.print(e.code)
    recover 0
  }
  discard rawSql.execute("drop table users") catch e {
    console.print(e.code)
    recover 0
  }
  discard parsed("") catch e {
    console.print(e.code)
    recover 0
  }
}
