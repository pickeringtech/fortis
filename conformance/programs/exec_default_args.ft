// execute: 10|15|7
// requires: runtime
// covers: LANG-05-09
import fortis.host { Console }

pure func scale(value: Int, factor: Int = 5) Int => Int.wrappingMul(value, factor)

func main(console: Console) {
  console.print("${scale(2)}")
  console.print("${scale(3)}")
  console.print("${scale(value: 7, factor: 1)}")
}
