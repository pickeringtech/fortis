// execute: live audit 5|quiet audit 5|staging-key
// covers: PLAT-03-02, PLAT-03-07
// A child context (Staging) inherits its parent's bindings and inputs, and its nearest binding wins; a test or a
// staging deployment is a different context value, so nothing it binds is visible to the parent's instances.
import fortis.host { Console }

export class Audit {
  prefix: String
  export func line(self, n: Int) String => "${self.prefix} audit ${n}"
}

export class Keys {
  value: String
}

export class Billing {
  inject audit: Audit
  inject keys: Keys
  export func bill(self, n: Int) String => self.audit.line(n)
}

context Production(key: owned String) {
  provide Keys using instance Keys(value: move key)
  provide Audit using instance Audit(prefix: "live")
  provide Billing
}

context Staging {
  provide Audit using instance Audit(prefix: "quiet")
  parent Production
}

func main(console: Console) {
  let live = Production.application("live-key")
  let staging = Staging.application("staging-key")
  console.print(live.billing().bill(5))
  console.print(staging.billing().bill(5))
  console.print(staging.billing().keys.value)
}
