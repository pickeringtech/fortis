// reject: E-DI-003 (at the marked line)
// covers: PLAT-03-02
// A child binding that overlaps a more specific parent binding must say `replaces` (Platform 3.3).
export class Gateway {
  name: String
}
export class Checkout {
  inject gateway: Gateway
}
context Production {
  provide Gateway using instance Gateway(name: "live") to Checkout.gateway
  provide Checkout
}
context Staging {
  parent Production
  provide Gateway using instance Gateway(name: "test")                // reject: E-DI-003 — overlaps a slot binding
}
