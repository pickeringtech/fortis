// execute: wired 6|manual 6|test 7
// covers: PLAT-03-01, PLAT-03-07
// An `inject` slot is a parameter of the class's generated constructor, so a consumer can be built by hand (a test
// passes its own dependencies) exactly as the context builds it.
import fortis.host { Host }

export class Rate {
  percent: Int
}

export class Tax {
  inject rate: Rate
  export func on(self, amount: Int) Int => Int.wrappingMul(amount, self.rate.percent) / 100
}

context Production {
  provide Rate using instance Rate(percent: 20)
  provide Tax
}

context Testing {
  provide Rate using instance Rate(percent: 35)
  provide Tax
}

export func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let wired = Production.application().tax()
  let manual = Tax(rate: Rate(percent: 20))
  caps.console.print("wired ${wired.on(30)}")
  caps.console.print("manual ${manual.on(30)}")
  caps.console.print("test ${Testing.application().tax().on(20)}")
}
