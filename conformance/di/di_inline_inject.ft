// execute: badge: gold|pair: gold silver
// covers: PLAT-03-01
// A slot written on the class's own line, or beside another member, loses the word `inject` at its own column.
import fortis.host { Console }

export class Label { text: String }

export class Badge { inject label: Label }

export class Pair {
  inject first: Label
  second: Label = Label(text: "silver")
}

context Production {
  provide Label using instance Label(text: "gold") { lifetime: application }
  provide Badge
  provide Pair
}

func main(console: Console) {
  let app = Production.application()
  console.print("badge: ${app.badge().label.text}")
  let p = app.pair()
  console.print("pair: ${p.first.text} ${p.second.text}")
}
