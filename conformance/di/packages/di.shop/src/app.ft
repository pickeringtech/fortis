// execute: basket of 3: 21|basket of 5: 35
// covers: PLAT-03-01, PLAT-03-02
// A context in one module wires consumers declared in another module of the package; the plan names the package
// and its version (static provenance, Platform 3.5).
import fortis.host { Console }
import di.shop.services { Prices, Quote, Basket }

context Shop(base: Int) {
  provide Shared[Prices] using instance Shared.create(Prices(base: base))
  provide Quote
  provide Basket
}

func main(console: Console) {
  let shop = Shop.application(7)
  console.print(shop.basket().total(3))
  console.print(shop.basket().total(5))
}
