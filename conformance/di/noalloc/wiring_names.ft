// execute: 23|23
// SP-08 provenance under noalloc, the variant whose events also carry the consumer's name as a bounded String: the
// elaborated wiring of wiring_provenance.ft (`fortisc elaborate conformance/di/noalloc/wiring_provenance.ft`) with
// that one change, written by hand. The experiment records what the checkers, the plan step and the allocator
// probe say about the noalloc handler whose wiring records it.
import fortis.host { Host, Clock, Supervisor, Capabilities }

export class Rates {
  percent: Int
}

export trivial class Bias {
  amount: Int
}

export trivial class Step {
  size: Int = 1
}

export class Calculator {
  rates: Shared[Rates]
  bias: Bias
  step: Step
  export noalloc func apply(self, n: Int<0..1000>) Int => Int.wrappingAdd(Int.wrappingMul(n, self.rates.percent), Int.wrappingAdd(self.bias.amount, self.step.size))
}








noalloc async func handle(app: owned ProductionApplication, clock: owned Shared[Clock], n: Int<0..1000>) Int {
  let c = app.calculator()
  await clock.sleep(1ms)
  return c.apply(n)
}

export async func main(args: List[String]) Void {
  let caps = Host.capabilities()
  let Capabilities(console: console, fileSystem: fs, network: net, clock: clk, random: rnd, environment: env, process: proc, supervisor: sup, secretAccess: sec, rawSql: sql) = move caps
  let clock = Shared.create(move clk)
  let first = await handle(Production.application(4, sup), clock.retain(), 5)
  let second = await handle(Production.application(4, sup), clock.retain(), 5)
  console.print("${first}")
  console.print("${second}")
}

// fortis: generated by fortis.di (DI schema v1) from the contexts of this module

observation ProductionProvenance {
  event: Int  required: none
  binding: Int  required: none
  level: Int  required: none
  consumer: String<scalars: 0..32>  required: none
  encoding: bounded(64)
}

class Production {
  export func application(percent: Int, supervisor: Supervisor) ProductionApplication {
    let bias: Bias = Bias(amount: 2)
    record ProductionProvenance(event: 1, binding: 0, level: 0, consumer: "Calculator")
    let sharedRates: Shared[Rates] = Shared.create(Rates(percent: percent))
    record ProductionProvenance(event: 1, binding: 2, level: 0, consumer: "Calculator")
    return ProductionApplication(sharedRates: move sharedRates, bias: move bias)
  }
}

class ProductionApplication {
  sharedRates: Shared[Rates]
  bias: Bias
  cleanup(editable self) Void {
    record ProductionProvenance(event: 3, binding: 2, level: 0, consumer: "Calculator")
    record ProductionProvenance(event: 3, binding: 0, level: 0, consumer: "Calculator")
  }
  export func calculator(self) Calculator {
    record ProductionProvenance(event: 2, binding: 2, level: 0, consumer: "Calculator")
    record ProductionProvenance(event: 2, binding: 0, level: 0, consumer: "Calculator")
    let v1: Step = Step()
    record ProductionProvenance(event: 1, binding: 3, level: 5, consumer: "Calculator")
    let result: Calculator = Calculator(rates: self.sharedRates.retain(), bias: copy self.bias, step: move v1)
    record ProductionProvenance(event: 1, binding: 1, level: 5, consumer: "Calculator")
    return move result
  }
  export func step(self) Step {
    let result: Step = Step()
    record ProductionProvenance(event: 1, binding: 3, level: 5, consumer: "Calculator")
    return move result
  }
}
