// Collections and closures: List operations, callbacks, capture lists.
// Run: bin/fortis run examples/04_collections.ft
import fortis.host { Console }

func sum(items: List[Int]) Int {
  let mut acc = 0
  for item in items {
    acc = Int.wrappingAdd(acc, item)
  }
  return acc
}

func main(console: Console) {
  let numbers = List.of(3, 1, 4, 1, 5, 9, 2, 6)
  console.print("numbers ${numbers}")
  console.print("count ${numbers.count()}, sum ${sum(numbers)}")
  let evens = numbers.filter(fn(n: Int) Bool => n % 2 == 0)
  console.print("evens ${evens}")
  let doubled = numbers.map(fn(n: Int) Int => Int.wrappingMul(n, 2))
  console.print("doubled ${doubled}")
  console.print("big ones ${numbers.countWhere(fn(n: Int) Bool => n > 4)}")
  let mut seen = 0
  {
    let mut tally = fn mut[editable seen](n: Int) Void {
      seen = Int.wrappingAdd(seen, n)
    }
    tally(10)
    tally(20)
  }
  console.print("tally ${seen}")
  let mut stack: List[Int] = List.default()
  stack.push(1)
  stack.push(2)
  let top = stack.pop() ?? -1
  console.print("popped ${top}, left ${stack.count()}")
}
