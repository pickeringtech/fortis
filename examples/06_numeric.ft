// Numeric: an Int operator the checker cannot prove safe is checked, and handled like a fallible call
// (`big + 1 catch e`); Decimal and Duration are exact.
// Run: bin/fortis run examples/06_numeric.ft
import fortis.host { Console }

recovers func main(console: Console) {
  let big = 9_223_372_036_854_775_807
  let overflow = big + 1 catch e {
    console.print("checked add failed: ${e.code}")
    recover 0
  }
  console.print("wrapping: ${Int.wrappingAdd(big, 1)}")
  console.print("saturating: ${Int.saturatingAdd(big, 1)}")
  let price = Decimal.mul(19.99d, 3d) or recover 0d
  console.print("price ${price}")
  let third = Decimal.div(1d, 3d) catch e {
    console.print("inexact division: ${e.code}")
    recover 0d
  }
  let span = Duration.add(90s, 1500ms) or recover 0s
  console.print("span ${span}")
  console.print("float ${1.5 * 4.0}")
}
