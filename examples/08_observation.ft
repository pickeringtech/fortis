// Observation: @observe attaches a schema; `capture` snapshots fields into the activation's frame,
// which is emitted as a record at exit; `record` emits an event each time it runs.
// Run: bin/fortis run examples/08_observation.ft   (records go to stderr; pipe stderr for JSON)
import fortis.host { Console }

observation OrderProcessing {
  version: 1
  items: Int                         required: all
  total: Int                         required: success
  encoding: bounded(256)
}

observation Line {
  value: Int                         required: all
}

@observe(OrderProcessing)
func process(prices: List[Int]) Int {
  capture items = prices.count()
  let mut total = 0
  for p in prices {
    record Line(value: p)
    total = Int.wrappingAdd(total, p)
  }
  capture total = total
  return total
}

func main(console: Console) {
  console.print("total ${process(List.of(5, 7, 11))}")
}
