// Hello: `main` declares the capabilities it needs as parameters; output goes through the Console capability.
// Run: bin/fortis run examples/01_hello.ft
import fortis.host { Console }

func main(console: Console, args: List[String]) {
  console.print("hello from Fortis")
  console.print("arguments: ${args.count()}")
  for i in 1..3 {
    console.print("tick ${i}")
  }
}
