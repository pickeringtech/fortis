// Ownership: values have one owner; `alias` and `editable` are loans visible at the call (a method called on a
// `let mut` binding needs no marker: the binding already says it changes);
// `move` transfers; `cleanup` runs when an owner is destroyed, in reverse declaration order.
// A loan never lives in a field, so values that all need the console share it through an
// explicit `Shared` handle: each `retain()` is visible where it happens.
// Run: bin/fortis run examples/03_ownership.ft
import fortis.host { Console }

export class Counter {
  export value: Int
  export func bump(editable self, by: Int) {
    self.value = Int.wrappingAdd(self.value, by)
  }
}

export class Resource {
  export id: Int
  export console: Shared[Console]
  cleanup(editable self) {
    self.console.print("release ${self.id}")
  }
}

func total(a: Counter, b: Counter) Int => Int.wrappingAdd(a.value, b.value)

func consume(c: owned Counter) Int => c.value

func run(console: Shared[Console]) {
  let first = Resource(id: 1, console: console.retain())
  let second = Resource(id: 2, console: console.retain())
  console.print("resources live")
}

func main(out: Console) {
  let console = Shared.create(move out)
  let mut a = Counter(value: 1)
  let mut b = Counter(value: 10)
  a.bump(2)
  b.bump(5)
  console.print("total ${total(a, b)}")
  console.print("consumed ${consume(move a)}")
  run(console)
  console.print("done")
}
