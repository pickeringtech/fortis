// Outcomes: a `try` function fails with a declared error; callers must consume the outcome
// with `or fail`, `or recover`, `catch` or `match`. `report` writes one runtime record to stderr.
// Run: bin/fortis run examples/02_outcomes.ft
import fortis.host { Host }

export error NotEven {
  code: "demo.not_even"
  payload { value: Int }
}

try func half(n: Int) Int {
  if n % 2 == 1 {
    fail NotEven(value: n)
  }
  return n / 2
}

// `recovers` is written because a failure is discharged without being reported.
recovers func halfOrZero(n: Int) Int => half(n) or recover 0

// A failure is matched by error, then its payload; `otherwise` owns whatever is left and must consume it.
recovers func describe(n: Int) String {
  return match half(n) {
    success(v) => "half of ${n} is ${v}"
    failure(f) => match move f {
      is NotEven(value: v) => "${v} is odd"
      otherwise(other) => {
        report other
        give "unexpected failure"
      }
    }
  }
}

// main carries `recovers` because `describe` and `halfOrZero` discharge failures silently (the effect is transitive).
export try recovers func main(args: List[String]) Void {
  let caps = Host.capabilities()
  caps.console.print(describe(8))
  caps.console.print(describe(7))
  caps.console.print("recovered: ${halfOrZero(7)}")
  let v = half(9) catch e {
    report e                               // one runtime-failure record on stderr
    recover -1
  }
  caps.console.print("after report: ${v}")
  let two = half(4) or fail                // propagates to the caller of main: exit 1 with a record
  caps.console.print("propagated: ${two}")
}
