// backstop: before|dynamic:`t` was moved (use after move)
// D-398: the VM's observed text for a run that stops with a dynamic check failure joins the console lines printed
// before the failure, as the interpreter observes them and as the defect path does (D-53); it once reported
// `dynamic:…` alone, with the lines only in its `out`. Both checkers reject this program (E-OWN-020, a use after
// the move), so it is built here whatever the checker reports, as its siblings are.
import fortis.host { Console }

class Token {
  label: String
}

func eat(t: owned Token) {
  discard t
}

func main(console: Console) {
  let t = Token(label: String.from("x"))
  console.print("before")
  eat(move t)
  console.print("${t.label}")
}
