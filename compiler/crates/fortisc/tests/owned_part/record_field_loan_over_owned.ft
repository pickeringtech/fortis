// execute: drop old|replaced list side|drop side|list list|end|drop list
// execute-trace:
// D-376, D-366, LR 7.9: assigning a loan to a field of a record literal that held a value of the record's own
// (`rec.item = xs.get(0) ?? make(…)` after `{ item: empty.get(0) ?? move d, … }`) destroys the old value and leaves
// the field a loan: the record then destroys its other fields with itself and the list's element with the list. The
// interpreter never ran the old value's cleanup and destroyed the list's element with the record; the VM was right.
// Native code does not build a record holding a loan (D-360), so this shape is pinned here, on the VM, with the
// interpreter's lines.
import fortis.host { Console }

class Token {
  label: String
  console: Shared[Console]

  cleanup(editable self) {
    self.console.print("drop ${self.label}")
  }
}

func make(console: Shared[Console], label: StringView) Token {
  return Token(label: String.from(label), console: console.retain())
}

func main(out: Console) {
  let console = Shared.create(move out)
  let empty: List[Token] = List.default()
  let mut xs: List[Token] = List.default()
  xs.push(make(console, "list"))
  let d = make(console, "old")
  {
    let mut rec = { item: empty.get(0) ?? move d, side: make(console, "side") }
    rec.item = xs.get(0) ?? make(console, "z")
    console.print("replaced ${rec.item.label} ${rec.side.label}")
  }
  console.print("list ${xs.get(0)?.label ?? "none"}")
  console.print("end")
}
