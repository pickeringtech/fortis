// execute: bye 5|got 5|bye 7|got 7|end
// execute-trace: loans-end|defer|loans-end|defer
// D-411, D-415, LR 6.11, 7.5, 12.1: an anonymous record whose fields are all trivial is trivial, so `return r`
// copies it and a deferred block that reads it in a hole after the return still sees it, whether its fields are
// integers or a value of a class declared `trivial`. The interpreter prints the same lines (D-411: it marked the
// local moved when a trivial class was inside); native code does not build a record returned past a deferred block
// that reads it (D-415: the record is moved, not copied, so the Rust does not compile).
import fortis.host { Console }

trivial class Point {
  export x: Int
  export y: Int
}

func ints(console: Shared[Console]) { n: Int, m: Int } {
  let r = { n: 5, m: 8 }
  defer {
    console.print("bye ${r.n}")
  }
  return r
}

func points(console: Shared[Console]) { p: Point, n: Int } {
  let r = { p: Point(x: 7, y: 6), n: 8 }
  defer {
    console.print("bye ${r.p.x}")
  }
  return r
}

func main(console: Console) {
  let shared = Shared.create(move console)
  let a = ints(shared)
  shared.print("got ${a.n}")
  let b = points(shared)
  shared.print("got ${b.p.x}")
  shared.print("end")
}
