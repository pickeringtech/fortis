// Repro (FRICTION entry 20): a comparison narrows a place in the branches of an `if` statement but not in the
// branches of an `if` expression. Both checkers accept `statementForm` and reject `expressionForm` with
// E-REF-001 at line 20 ("returned value has interval [-9, 9], which is not within Int<0..9>"), although each branch of
// the expression is in [0, 9] (`0 - d` with d in [-9, -1], or `d` with d in [0, 9]).
// Docs: agent/06-proofs.md is a stub; it promises "Narrowing: ... else-negation" without saying where it applies.

pure func statementForm(n: Int) Int<0..9> {
  let d = n % 10
  let mut digit: Int<0..9> = 0
  if d < 0 {
    digit = 0 - d
  } else {
    digit = d
  }
  return digit
}

pure func expressionForm(n: Int) Int<0..9> {
  let d = n % 10
  return if d < 0 { give 0 - d } else { give d }
}

test "digits" {
  expect statementForm(-47) == 7
  expect expressionForm(-47) == 7
}
