// Repro (FRICTION entry 20; D-52.9): a comparison narrowed a place in the branches of an `if` statement but not in the
// branches of an `if` expression: both checkers accepted `statementForm` and rejected `expressionForm` with E-REF-001
// ("returned value has interval [-9, 9], which is not within Int<0..9>"), although each branch of the expression is in
// [0, 9] (`0 - d` with d in [-9, -1], or `d` with d in [0, 9]). It no longer reproduces: at v0.0.2-rc.9, and at v0.0.1,
// both checkers accept both forms and the test passes (the wide review's re-check).

pure func statementForm(n: Int) Int<0..9> {
  let d = n % 10
  let mut digit: Int<0..9> = 0
  if d < 0 {
    digit = 0 - d
  } else {
    digit = d
  }
  return digit
}

pure func expressionForm(n: Int) Int<0..9> {
  let d = n % 10
  return if d < 0 { give 0 - d } else { give d }
}

test "digits" {
  expect statementForm(-47) == 7
  expect expressionForm(-47) == 7
}
