// ---- collections (6.7) ----
export class List[T] {
  export trusted pure func default() List[T]
  export trusted pure func of(...items: owned T) List[T]
  export trusted pure func count(self) Int
  export trusted func push(editable self, item: owned T)
  export trusted func pop(editable self) T?
  export trusted pure func get(self, index: Int) (alias T from self)?
  export trusted pure try func at(self, index: Int) T
  export trusted try func set(editable self, index: Int, value: owned T)
  export trusted func clear(editable self)
  export trusted pure func isEmpty(self) Bool
  export trusted pure func first(self) (alias T from self)?
  export trusted pure func reversed(self) List[T] where T implements Copyable
  export trusted pure func concat(self, other: ListView[T]) List[T] where T implements Copyable
  export trusted pure func countWhere(self, keep: pure fn(T) Bool) Int
  export trusted pure func map[U](self, f: pure fn(T) U) List[U] where U: linear
  export trusted pure func filter(self, keep: pure fn(T) Bool) List[T] where T implements Copyable
  export trusted func each(self, visit: editable fn mut(T) Void)
  export trusted try func tryEach(self, visit: editable fn mut(T) Outcome[Void])
  // U must be non-linear: failure drops earlier results (10.7, E-OBL-003).
  export trusted pure try func tryMap[U](self, f: pure fn(T) Outcome[U]) List[U]
  export trusted pure func fold[A](self, initial: owned A, step: pure fn(A, T) A) A
  export trusted pure try func tryFold[A](self, initial: owned A, step: pure fn(A, T) Outcome[A]) A
  export trusted pure func any(self, holds: pure fn(T) Bool) Bool
  export trusted pure func all(self, holds: pure fn(T) Bool) Bool
  export trusted pure func find(self, holds: pure fn(T) Bool) (alias T from self)?
  export trusted pure func indexWhere(self, holds: pure fn(T) Bool) Int?
  export trusted pure func contains(self, target: T) Bool where T implements Equatable
  export trusted pure func enumerate(self) List[(Int, T)] where T implements Copyable
  export trusted pure func zip[U](self, other: ListView[U]) List[(T, U)] where T implements Copyable, U implements Copyable
  export trusted pure func take(self, n: Int) List[T] where T implements Copyable
  export trusted pure func skip(self, n: Int) List[T] where T implements Copyable
  export trusted pure func flatMap[U](self, f: pure fn(T) List[U]) List[U] where U: linear
  export trusted pure func chunked(self, size: Int<1..>) List[List[T]] where T implements Copyable
  export trusted pure func sortedBy[K](self, key: pure fn(T) K) List[T] where T implements Copyable, K implements Comparable
  export trusted pure func groupBy[K](self, key: pure fn(T) K) Map[K, List[T]] where T implements Copyable, K implements Copyable, K implements Hashable, K implements Equatable
  export trusted pure func iterate(self) ListCursor[T] from self
  export trusted func consumeEach(owned self, visit: fn mut(owned T) Void)
}
