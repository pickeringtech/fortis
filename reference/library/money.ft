// Signature module for `fortis.money` (Language Reference 15).
export enum Currency derive Equatable {
  GBP
  EUR
  USD
}
export error CurrencyMismatch {
  code: "money.currency_mismatch"
  payload { left: Currency, right: Currency }
  message: "cannot combine ${left} with ${right}"
}
export class Money {
  export currency: Currency
  export amount: Decimal
  export trusted pure func of(currency: Currency, amount: Decimal) Money
  export trusted pure func zero(currency: Currency) Money
  export trusted pure try func add(a: Money, b: Money) Money
  export trusted pure try func subtract(a: Money, b: Money) Money
  export trusted pure try func multiply(money: Money, factor: Int) Money
  export trusted pure try func divide(money: Money, divisor: Int<1..>) Money
  export trusted pure func greaterThan(a: Money, b: Money) Bool
}
